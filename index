const MODE_RE = /(?:^|[^A-Za-z])(PRVC|APRV|SIMV(?:[-\s]?(?:PC|VC|PRVC))?(?:\s?\+\s?PS)?|PC[-\s]?AC|VC[-\s]?AC|AC[-\s]?(?:PC|VC)|A\/C|PCV|VCV|PSV|CPAP(?:\s?\+\s?PS)?|Bi-?PAP|NIV|HFNC|HFOV|T[-\s]?piece|ASV|NAVA|PC|VC|PS|AC)(?![A-Za-z])/i;


function aliasRe(a){return new RegExp('(?:^|[^A-Za-z0-9])(?:'+a+')(?![A-Za-z])\\s*(?:\\([^)]{0,12}\\))?\\s*%?\\s*[:：=]?\\s*(-?\\d+(?:\\.\\d+)?)','gi');}
const ALIAS_RES = FIELDS.map(f=>[f[0],f[3].map(aliasRe)]);


function norm(k,v){
  if(v==null||isNaN(v))return null;
  const f=FMAP[k];if(!f)return v;
  if(k==='fio2'&&v<=1)v=v*100;
  if(k==='vt'&&v<=1.5)v=v*1000;
  if(v<f[4][0]||v>f[4][1])return null;
  return v;
}


