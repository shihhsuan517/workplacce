    if(h>=0&&h<24*14)auto=p.birthTime?`生後 ${Math.round(h)}h${h>=18&&h<=36?'（≈24h）':h>=40&&h<=56?'（≈48h）':h>=60&&h<=84?'（≈72h）':''}`:`DOL ${Math.floor(h/24)}`;
