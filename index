  }
  L.push(`  * Liver function：ALT/AST: ${V(g('72-361'))}/${V(g('72-360'))} U/L, Bil T/D: ${V(g('72-365'))}/${V(g('72-366'))} mg/dL; ALK-P: ${V(g('72-363'))} U/L; Albumin: ${V(g('72-303'))} g/dL; γ-GT: ${V(g('72-368'))} U/L`+(t==='adult'?` Ammonia: ${V(g('72-534'))}`:''));
