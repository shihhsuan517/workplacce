    if(hit){cur=hit[0];const rest=l.replace(hit[1],'');
      if(['dept','doctor','reqDate','replyDate'].includes(cur)){r[cur]=rest.split(/\s{3,}/)[0].trim();cur=null;}else r[cur]+=(r[cur]?'\n':'')+rest;return;}
