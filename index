  const dm=text.match(/(\d{4})\/(\d{1,2})\/(\d{1,2})\s+(\d{1,2}):(\d{2})/);
  r.at=dm?`${dm[1]}-${pad(+dm[2])}-${pad(+dm[3])} ${pad(+dm[4])}:${dm[5]}`:ymd()+' '+hm();
  let cur=null;const order='SOAP';
  L.forEach(l=>{
    const m=l.match(PN_SEC);
    if(m){const k=FW[m[1]]||m[1];if(!cur||order.indexOf(k)>order.indexOf(cur)){cur=k;if(m[2].trim())r[k]+=m[2]+'\n';return;}}
    if(cur==='P'||['meds','vsc','teach','comm'].includes(cur)){
      if(/^\s*藥名\s+劑量/.test(l)){cur='meds';return;}
      if(/^\s*醫病溝通/.test(l)){cur='comm';return;}
      if(/主治醫師迴診意見/.test(l)){cur='vsc';return;}
      if(/^\s*Teaching\s*[:：]/i.test(l)){cur='teach';return;}
      if(/^\s*-{5,}\s*$/.test(l)||/^\s*_{10,}\s*$/.test(l))return;
    }
    if(cur)r[cur]+=l+'\n';
  });
  for(const k in r)if(typeof r[k]==='string'&&k!=='at')r[k]=r[k].replace(/^\s*\n|\s+$/g,'');
  // 體重、PMA、日齡
  const sl=r.S.split('\n');const wl=sl.find(l=>/PMA|\bBW\b|體重/i.test(l)&&/\d{3,5}\s*(?:g|gm|grams?)\b/i.test(l)&&!/\[\s*\d{1,2}\/\d{1,2}\s*,\s*GA/i.test(l));
  if(wl){const w=wl.match(/(?:BBW|BW|weight|體重)\s*[:：]?\s*(\d{3,5})\s*(?:g|gm|grams?)\s*(?:\(\s*([+\-]\s*\d+)\s*\))?/i);if(w){r.wtG=+w[1];if(w[2])r.wtChg=w[2].replace(/\s/g,'');}
    const pm=wl.match(/PMA\s*[:：]?\s*(\d{2}\s*\+\s*\d)/i);if(pm)r.pma=pm[1].replace(/\s/g,'');
    const dl=wl.match(/\b(\d{1,3})\s*D\b/);if(dl)r.dol=+dl[1];}
  if(!r.wtG){const w=(r.S+'\n'+r.O).match(/(?:body\s*weight|BW|體重)\s*[:：]?\s*(\d+(?:\.\d+)?)\s*kg/i);if(w)r.wtKg=+w[1];}
  const v=r.O;const g=re=>{const x=v.match(re);return x?x[1]:'';};
  r.vs={T:g(/\bT\s*[:：]\s*([\d.]+)/),P:g(/\bP\s*[:：]\s*(\d+)/),R:g(/\bR\s*[:：]\s*(\d+)/),BP:(v.match(/BP\s*[:：]\s*(\d+)\s*(?:\([^)]*\))?\s*\/\s*(\d+)/)||[]).slice(1,3).join('/')};
  const io=v.match(/攝入小計\s*[:：]\s*([\d.]+)[\s\S]{0,40}?排出小計\s*[:：]\s*([\d.]+)/);if(io)r.io={in:+io[1],out:+io[2]};
  r.neo=neoExtract(r.S,r.at.slice(0,4));
  r.text=String(text).replace(/\r/g,'').trim();
  return r;
}
function progStore(p){if(!Array.isArray(p.prog))p.prog=[];return p.prog;}
const progSorted=p=>[...progStore(p)].sort((a,b)=>b.at.localeCompare(a.at));
function mergeProgress(p,r){
  const E=progStore(p);const ex=E.find(x=>x.at===r.at);
  if(ex)Object.assign(ex,r);else E.push(Object.assign({id:'g'+uid().slice(1)},r));
  const got=applyNeo(p,r.neo||{});
