  text.replace(/\r/g,'').split('\n').forEach(raw=>{
    const m=raw.match(/列印時間\s*[:：]\s*(\d{4})\/(\d{1,2})\/(\d{1,2})\s+(\d{1,2}):(\d{2})/);
    if(m){flush();t=new Date(+m[1],+m[2]-1,+m[3],+m[4],+m[5]);sec='';return;}
    if(/^\s*類別\s+醫囑名稱/.test(raw)){flush();sec='note';return;}
    if(/^\s*類別\s+藥品名稱/.test(raw)||/醫師\s*[:：]/.test(raw)||/^\s*@{5,}/.test(raw)){flush();sec='';return;}
    if(sec!=='note'||!t)return;
    if(!raw.trim()){flush();return;}
    const cat=raw.slice(0,8).trim(),body=raw.slice(8).replace(/\s+$/,'');
    const txt=body.split(/\s{3,}/)[0];          // 右側是用法／檢體欄
    if(cur&&cur.wrap){cur.text+=txt;cur.wrap=false;}   // 接續上一行（保留原本的前導空白）
    else{flush();cur={t,cat,text:txt.trim()};}
    if(/-$/.test(cur.text.trimEnd())){cur.text=cur.text.trimEnd().slice(0,-1);cur.wrap=true;}
  });
  flush();return out;
}
