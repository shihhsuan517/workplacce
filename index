const DTC=/^\s*\d{3,4}[\/\-.]\d{1,2}[\/\-.]\d{1,2}\s+\d{1,2}:\d{2}\s*$/;
function tryWide(txt){
  const lines=txt.split('\n');let hi=-1,start=-1,times=[];
  for(let i=0;i<lines.length;i++){
    const cells=lines[i].split('\t');const idx=cells.map((c,j)=>DTC.test(c)?j:-1).filter(j=>j>=0);
    if(idx.length>=2||(/照護時間/.test(cells[0])&&idx.length)){hi=i;start=idx[0];times=cells.slice(start).map(c=>c.trim());break;}
  }
  if(hi<0)return null;
  while(times.length&&!DTC.test(times[times.length-1]))times.pop();
  const recs=times.map(t=>({time:normDT(t)}));
  for(const ln of lines.slice(hi+1)){
    const cells=ln.split('\t');
    const lab=cells.slice(0,start).map(s=>s.trim()).filter(Boolean).pop()||'';
    if(!lab)continue;
    const def=WIDE.find(w=>w[0].test(lab));if(!def)continue;
    const keys=def[1];
    times.forEach((_,j)=>{
      const raw=(cells[start+j]||'').trim();if(!raw||/^\/*$/.test(raw))return;
      const parts=keys.length===1?[raw]:raw.split('/');
      keys.forEach((k,q)=>{const p=(parts[q]||'').trim();if(!p)return;
        if(TEXTKEYS.has(k)){recs[j][k]=k==='mode'?p.toUpperCase():p;return;}
        const v=norm(k,parseFloat(p));if(v!=null)recs[j][k]=v;});
    });
  }
  recs.forEach(r=>{if(r.mv==null&&r.mvmin!=null)r.mv=r.mvmin;});
  return recs.filter(r=>Object.keys(r).length>1);
}


/* ===================== 一般文字 / Excel 解析 ===================== */
function parseChunk(txt){
  const r={};
  const am=txt.match(/(?:^|[^\d.])(7\.\d{1,3})\s*\/\s*(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)(?:\s*\/\s*(-?\d+(?:\.\d+)?))?/);
  if(am){r.ph=norm('ph',+am[1]);r.paco2=norm('paco2',+am[2]);r.pao2=norm('pao2',+am[3]);r.hco3=norm('hco3',+am[4]);if(am[5]!=null)r.be=norm('be',+am[5]);}
  const rm=txt.match(/(?:^|[^A-Za-z])(?:RR|f|Rate)\s*[:：=]?\s*(\d+)\s*\/\s*(\d+)/i);
  if(rm){r.rrset=norm('rrset',+rm[1]);r.rr=norm('rr',+rm[2]);}
  const vm=txt.match(/(?:^|[^A-Za-z])(?:Vt|VT|TV)\s*[:：=]?\s*(\d+)\s*\/\s*(\d+)/);
  if(vm){r.vt=norm('vt',+vm[2]);}
  const bp=txt.match(/(?:^|[^A-Za-z])(?:BP|血壓)\s*[:：=]?\s*(\d{2,3})\s*\/\s*(\d{2,3})/i);
  if(bp){r.sbp=+bp[1];r.dbp=+bp[2];}
  for(const [k,res] of ALIAS_RES){
    if(r[k]!=null)continue;
    outer: for(const re of res){
      re.lastIndex=0;let m;
      while((m=re.exec(txt))){const v=norm(k,parseFloat(m[1]));if(v!=null){r[k]=v;break outer;}}
    }
  }
  const mm=txt.match(/Mode\s*[:：=]\s*([A-Za-z][A-Za-z0-9\/+\- ]{0,14}?)(?=\s{2,}|[,;，；\n]|\s+[A-Za-z]+\s*[:：=]?\s*\d|$)/i)||txt.match(MODE_RE);
  if(mm)r.mode=mm[1].trim().toUpperCase();
  for(const k in r)if(r[k]==null)delete r[k];
  return Object.keys(r).length?r:null;
}
function pad(n){return String(n).padStart(2,'0');}
function normDT(s){
  let m=s.match(/(\d{3,4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})(?:[\sT]+(\d{1,2}):(\d{2}))?/);
  if(m){let y=+m[1];if(y<1000)y+=1911;return `${y}/${pad(m[2])}/${pad(m[3])}`+(m[4]?` ${pad(m[4])}:${m[5]}`:'');}
  m=s.match(/(\d{1,2})\/(\d{1,2})\s+(\d{1,2}):(\d{2})/);
  if(m)return `${new Date().getFullYear()}/${pad(m[1])}/${pad(m[2])} ${pad(m[3])}:${m[4]}`;
  return s.trim();
}
function headerKey(h){
  if(/時間|日期|time|date/i.test(h))return 'time';
  if(/^mode|模式/i.test(h))return 'mode';
  for(const f of FIELDS)for(const a of f[3])if(new RegExp('^\\s*(?:'+a+')(?![A-Za-z])','i').test(h))return f[0];
  return null;
}
function tryTable(txt){
  const lines=txt.split('\n').filter(l=>l.trim());
  for(let h=0;h<Math.min(lines.length,5);h++){
    if(!lines[h].includes('\t'))continue;
    const map=lines[h].split('\t').map(s=>headerKey(s.trim()));
    if(map.filter(x=>x&&x!=='time'&&x!=='mode').length<3)continue;
    const recs=[];
    for(const ln of lines.slice(h+1)){
      const cells=ln.split('\t');const r={};
      map.forEach((k,i)=>{const c=(cells[i]||'').trim();if(!k||!c)return;
        if(k==='time')r.time=normDT(c);else if(k==='mode')r.mode=c.toUpperCase();
        else{const v=norm(k,parseFloat(c.replace(/[%,]/g,'')));if(v!=null)r[k]=v;}});
      if(Object.keys(r).length>1)recs.push(r);
    }
    return recs;
  }
  return null;
}
function parseText(txt){
  txt=cutSig(txt.replace(/\r/g,''));
  const wide=tryWide(txt);if(wide&&wide.length)return {recs:wide,how:'RT 照護紀錄表(橫向時間)',wide:true};
  const tab=tryTable(txt);if(tab)return {recs:tab,how:'表格模式'};
  const re=/(^|\n)[ \t]*((?:\d{3,4})[\/\-.]\d{1,2}[\/\-.]\d{1,2}(?:[ \tT]+\d{1,2}:\d{2})?|\d{1,2}\/\d{1,2}[ \t]+\d{1,2}:\d{2})/g;
  const hits=[];let m;while((m=re.exec(txt)))hits.push({i:m.index+m[1].length,dt:m[2]});
  if(!hits.length){const r=parseChunk(txt);return {recs:r?[Object.assign({time:''},r)]:[],how:'單筆(未偵測到日期時間)'};}
  const recs=[];
  const pre=parseChunk(txt.slice(0,hits[0].i));if(pre)recs.push(Object.assign({time:''},pre));
  hits.forEach((h,k)=>{const end=k+1<hits.length?hits[k+1].i:txt.length;
    const r=parseChunk(txt.slice(h.i+h.dt.length,end));if(r)recs.push(Object.assign({time:normDT(h.dt)},r));});
  return {recs,how:'文字模式'};
}
function toDate(t){const m=(t||'').match(/(\d{4})\/(\d{2})\/(\d{2})(?: (\d{2}):(\d{2}))?/);return m?new Date(+m[1],m[2]-1,+m[3],+(m[4]||0),+(m[5]||0)):null;}
function mergeClose(recs,win){
  const out=[];let n=0;
  for(const r of recs){
    const last=out[out.length-1];
    if(last){const a=toDate(last.time),b=toDate(r.time);
      const keys=Object.keys(r).filter(k=>k!=='time'&&k!=='mode');
      const clash=keys.some(k=>last[k]!=null)||(r.mode&&last.mode&&r.mode!==last.mode);
      if(a&&b&&Math.abs(b-a)<=win*60000&&!clash){for(const k of keys)last[k]=r[k];if(r.mode)last.mode=r.mode;n++;continue;}}
    out.push(r);
  }
  return {out,n};
}


/* ===================== 計算 ===================== */
const isSpont=m=>/^(PSV?|CPAP(\s?\+\s?PS)?|T[-\s]?PIECE|VS|SPONT|HFNC)$/i.test((m||'').trim());
const isVC=m=>/(^|[^R])VC/i.test(m||'');
const isPC=m=>/PC|PRVC/i.test(m||'')&&!isSpont(m);
function pbw(pt){if(!pt.sex||!pt.ht)return null;return (pt.sex==='M'?50:45.5)+0.91*(pt.ht-152.4);}
function calc(r,pt){
  const c={},fi=r.fio2;
  c.peepE=r.peeptot!=null?r.peeptot:(r.peep!=null?r.peep+(r.autopeep||0):null);
  c.pfCalc=r.pao2&&fi?r.pao2/(fi/100):null;
  c.pf=c.pfCalc??r.pfrep??null;
  c.sf=r.spo2&&fi&&r.spo2<=97?r.spo2/(fi/100):null;
  c.oi=r.pmean&&fi&&r.pao2?fi*r.pmean/r.pao2:null;
  c.osi=r.pmean&&fi&&r.spo2?fi*r.pmean/r.spo2:null;
  c.dp=r.pplat!=null&&c.peepE!=null?r.pplat-c.peepE:null;
  c.cst=c.dp>0&&r.vt?r.vt/c.dp:null;
  c.dpEst=c.dp==null&&r.comp&&r.vt?r.vt/r.comp:null;
  c.dpx=c.dp??c.dpEst;
  c.cx=c.cst??r.comp??null;
  c.cdyn=r.ppeak&&c.peepE!=null&&r.vt&&r.ppeak-c.peepE>0?r.vt/(r.ppeak-c.peepE):null;
  c.pres=r.ppeak&&r.pplat?r.ppeak-r.pplat:null;
  c.pbw=pbw(pt);
  c.vtkg=r.vt&&c.pbw?r.vt/c.pbw:null;
  c.ve=r.mv?r.mv*1000:(r.vt&&r.rr?r.vt*r.rr:null);
  c.vr=c.ve&&r.paco2&&c.pbw?(c.ve*r.paco2)/(c.pbw*100*37.5):null;
  c.rsbi=r.rr&&r.vt?r.rr/(r.vt/1000):null;
  c.spont=isSpont(r.mode);
  c.aa=fi&&r.paco2!=null&&r.pao2?(fi/100*713-r.paco2/0.8)-r.pao2:null;
  c.mp=isVC(r.mode)&&r.rr&&r.vt&&r.ppeak&&c.dp!=null?0.098*r.rr*(r.vt/1000)*(r.ppeak-0.5*c.dp):null;
  c.map=r.sbp&&r.dbp?(r.sbp+2*r.dbp)/3:null;
  c.gap=r.paco2&&r.etco2?r.paco2-r.etco2:null;
  c.effort=isPC(r.mode)&&r.rr!=null&&r.rrset!=null&&r.rr-r.rrset>=6;
  c.pcDiff=isPC(r.mode)&&r.pinsp!=null&&r.peep!=null&&r.ppeak!=null?r.ppeak-(r.pinsp+r.peep):null;
  c.sedated=r.gcs?/SEDATION/i.test(r.gcs):null;
  return c;
}
function berlin(pf){if(pf==null)return null;if(pf<=100)return['重度 Severe','bad'];if(pf<=200)return['中度 Moderate','bad'];if(pf<=300)return['輕度 Mild','warn'];return['未達 ARDS 氧合標準','ok'];}


function abgInterp(r){
  const ph=r.ph,pc=r.paco2,h=r.hco3;if(ph==null||pc==null)return null;
  const N={RAc:'呼吸性酸中毒 Respiratory acidosis',MAc:'代謝性酸中毒 Metabolic acidosis',RAl:'呼吸性鹼中毒 Respiratory alkalosis',MAl:'代謝性鹼中毒 Metabolic alkalosis'};
  const P=[],add=[],lines=[];let lvl='ok';
  const status=ph<7.35?'酸血症 Acidemia':ph>7.45?'鹼血症 Alkalemia':'pH 正常範圍';
  if(ph<7.35){if(pc>45)P.push('RAc');if(h!=null&&h<22)P.push('MAc');}
  else if(ph>7.45){if(pc<35)P.push('RAl');if(h!=null&&h>26)P.push('MAl');}
  else if(h!=null){if(pc>45&&h>26)P.push(ph<7.40?'RAc':'MAl');else if(pc<35&&h<22)P.push(ph<7.40?'MAc':'RAl');}
  if(ph<7.35||ph>7.45)lvl=ph<7.25||ph>7.55?'bad':'warn';
  if(P.length===1&&h!=null){
    const p=P[0];
    if(p==='MAc'){const e=1.5*h+8;lines.push(`Winter's:預期 PaCO₂ ${(e-2).toFixed(0)}–${(e+2).toFixed(0)}`);
      if(pc>e+2)add.push('合併呼吸性酸中毒(呼吸代償不足)');else if(pc<e-2)add.push('合併呼吸性鹼中毒');else lines.push('呼吸代償適當');}
    if(p==='MAl'){const e=40+0.7*(h-24);lines.push(`預期 PaCO₂ ≈ ${(e-2).toFixed(0)}–${(e+2).toFixed(0)}(0.7×ΔHCO₃⁻)`);
      if(pc>e+2)add.push('合併呼吸性酸中毒');else if(pc<e-2)add.push('合併呼吸性鹼中毒');else lines.push('呼吸代償適當');}
    if(p==='RAc'||p==='RAl'){const d=Math.abs(pc-40),s=p==='RAc'?1:-1;
      const ea=24+s*(p==='RAc'?0.1:0.2)*d,ec=24+s*(p==='RAc'?0.35:0.5)*d;
      lines.push(`預期 HCO₃⁻:急性 ${ea.toFixed(1)}/慢性 ${ec.toFixed(1)}`);
      const lo=Math.min(ea,ec),hi=Math.max(ea,ec);
      if(h>hi+2)add.push('合併代謝性鹼中毒');else if(h<lo-2)add.push('合併代謝性酸中毒');
      else if(Math.abs(h-ea)<=2)lines.push('符合急性變化');else if(Math.abs(h-ec)<=2)lines.push('符合慢性代償');else lines.push('介於急性與慢性之間(acute-on-chronic 或部分代償)');}
  }
  let ag=null,cag=null,dd=null;
  if(r.na&&r.cl&&h!=null){ag=r.na-(r.cl+h);cag=r.alb?ag+2.5*(4-r.alb):ag;if(cag>14&&h<22)dd=(cag-12)/(24-h);}
  const hagma=cag!=null&&cag>14;
  if(hagma&&!P.includes('MAc')&&!add.some(a=>a.includes('代謝性酸')))add.push('AG 升高 → 隱藏的高 AG 代謝性酸中毒');
  if(dd!=null){if(dd<1)add.push('Δ/Δ <1:另合併正常 AG 代謝性酸中毒');else if(dd>2)add.push('Δ/Δ >2:另合併代謝性鹼中毒');}
  let primary;if(P.length)primary=P.map(x=>N[x]).join(' + ');else if(ph>=7.35&&ph<=7.45){const dv=[pc<35?'PaCO₂ 偏低(輕度過度換氣/呼吸性鹼中毒傾向)':pc>45?'PaCO₂ 偏高':'',h!=null&&h<22?'HCO₃⁻ 偏低':h!=null&&h>26?'HCO₃⁻ 偏高':''].filter(Boolean);primary=dv.length?'pH 正常;'+dv.join('、'):'酸鹼大致正常';}else primary='無法單純分類,請人工確認';
  if(P.length===2)lines.unshift('混合型酸鹼異常');
  if(add.length&&lvl==='ok')lvl='warn';
  return {status,primary,lines,add,ag,cag,dd,hagma,P,lvl};
}


