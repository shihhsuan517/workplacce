    L.push(`  * Renal function：BUN/Cr: ${V(g('72-307'))} / ${V(g('72-333'))} mg/dL,eGFR/CrCl: ${egfr} / ${crclTxt(renal)} mL/ min`);
  }else{
    L.push(`  * Electrolyte: Na/K: ${V(g('72-355'))}/${V(g('72-356'))} meq/L`);
    L.push(`  * Renal function：BUN/Cr: ${V(g('72-307'))}/${V(g('72-333'))} mg/dL,eGFR/CrCl: ${egfr}/ ${crclTxt(renal)}mL/ min`+(t==='peds'?`, Estimated GFR: ${renal&&renal.peds?renal.peds.egfr.toFixed(1):'-'} mL/min/1.73 m^2 (ref: Brion)`:''));
