async function openArchiveText(text,fileName){
  let r=null;
  try{r=await decryptText(text,S.pw);}
  catch(e){
    if(e.message==='FORMAT'){toast('這不是有效的病患檔');return;}
    const res=await modal('輸入舊病患檔密碼','這個檔案的密碼與目前工作檔不同。<input type="password">',[{t:'取消',v:false},{t:'開啟',v:true,cls:'pri'}]);
    if(!res.v)return;
    try{r=await decryptText(text,res.inputs[0]);}catch(e2){toast('密碼錯誤');return;}
  }
  const p=r.obj.patients&&r.obj.patients[0];
  if(r.kind!=='archive'||!p){toast('這是工作檔，不是舊病患檔');return;}
  ensurePatient(p);S.archive={patient:p,fileName};S.tab='overview';renderList();renderMain();
}
