          return;
        }
        if(pending && /^\s{4,}\S/.test(line)){
          const joined=pending.name+(pending.trail?" ":"")+line.trim();
          const cat=pending.cat; pending=null;
          if(!pushD(cat,joined)) unrec.push("（無法解析的藥品行）"+joined);
          return;
        }
        if(last){ last.notes.push(line.trim()); return; }
        return;
      }
      nonDrug++; if(curSheet && curSheet.other.length<3 && line.trim() && !/^\s*\(/.test(line)) curSheet.other.push(line.trim().replace(/^(DC|CHG|NEW|DC-[A-Z])\s+/,m=>m.trim()+' ').slice(0,60)); return;
    }
