const LABEL = Object.assign({time:'時間',mode:'Mode',sbp:'SBP',dbp:'DBP',cvp:'CVP',gcs:'GCS(E/V/M)',bs:'呼吸音',ca:'Ca',mg:'Mg',phos:'P',bun:'BUN',cr:'Cr',wbc:'WBC',crp:'CRP',hb:'Hb',plt:'PLT',pfrep:'P/F(報告)',oirep:'OI(報告)',osirep:'OSI(報告)',sao2:'SaO₂',mvday:'MV天數'},Object.fromEntries(FIELDS.map(f=>[f[0],f[1]])));
const GROUPS=[
  ['vent','呼吸器',['mode','fio2','peep','vt','rrset','rr','ppeak','pplat','pmean','pinsp','ps','mv','comp','res'],true],
  ['gas','氣體/監測',['spo2','etco2','ph','paco2','pao2','hco3','be','lac','osirep'],true],
