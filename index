async function discharge(p){
  if(S.mode==='sample'){toast('範例模式不提供歸檔');return;}
  const label=`${p.bed||''} ${p.code||''}`.trim()||'此病患';
  const ok=await confirmBox('移到舊病患',`會把「${esc(label)}」另存為一個加密的舊病患檔（建議存到「舊病患」資料夾），存檔成功後才從工作檔移除。<br><br>舊病患檔使用與工作檔相同的密碼。`,'選擇存檔位置');
  if(!ok)return;
  const fname=`${safeName(p.bed)}_${safeName(p.code)}_${ymd().replace(/-/g,'')}.jcpw`;
  const copy=JSON.parse(JSON.stringify(p));copy.dischargedAt=new Date().toISOString();
  let handle=null;
  if(FS){
    try{const opt={suggestedName:fname,types:FTYPES};if(S.lastArchiveHandle)opt.startIn=S.lastArchiveHandle;
      handle=await window.showSaveFilePicker(opt);}catch(e){return;}
  }
  try{
    const km=await newKeyMaterial(S.pw);
    const txt=await encryptObj({version:1,kind:'archive',patients:[copy]},km,'archive');
    if(handle){const w=await handle.createWritable();await w.write(txt);await w.close();S.lastArchiveHandle=handle;}
    else downloadText(txt,fname);
  }catch(e){toast('舊病患檔儲存失敗，病患仍保留在工作檔：'+e.message);return;}
  S.data.archivedIds=(S.data.archivedIds||[]).concat(p.id);
  S.data.patients=S.data.patients.filter(x=>x.id!==p.id);
  S.selId=sortedPatients()[0]?.id||null;S.tab='basic';
  markDirty();renderList();renderMain();toast(`已歸檔：${handle?handle.name:fname}`);
}


