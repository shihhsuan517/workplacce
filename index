function computeResult(cfg,amp,dose,vol,flow,weight){
  if(!amp||!dose||!vol)return {stage:'incomplete-basic'};
  const concOrig=amp*dose/vol,concOut=concOrig*cfg.conv;
  const concWarn=!!(cfg.maxConc&&concOrig>cfg.maxConc);
  if(!flow)return {stage:'incomplete-flow',concOrig,concOut,concWarn};
  const perHr=concOut*flow,final=cfg.timeDiv===60?perHr/60:perHr,perKg=weight>0?final/weight:null;
  const rangesEval=cfg.ranges.map(r=>{
    const v=r.wb?perKg:final;let flag;
    if(r.wb&&!(weight>0))flag='empty';else if(v>r.max)flag='over';else if(v<r.min)flag='under';else flag='ok';
    return Object.assign({},r,{value:v,flag});});
  return {stage:'done',concOrig,concOut,concWarn,perHr,final,perKg,rangesEval};
}
function doseSummary(c,r){
  const seen=new Set(),out=[];
  r.rangesEval.forEach(x=>{if(x.flag==='empty'||seen.has(x.unit))return;seen.add(x.unit);out.push(`${fmtN(x.value)} ${x.unit}`);});
  if(!out.length)out.push(`${fmtN(r.final)} ${c.outUnit}/${c.timeDiv===60?'min':'hr'}（需體重換算）`);
  return out.join(' = ');
}
