async function mergeWorkText(text,fileName){
  let r=null;
  try{r=await decryptText(text,S.pw);}catch(e){
    if(e.message==='FORMAT'){toast('這不是有效的工作檔');return;}
    const res=await modal('輸入工作檔密碼','這個檔案的密碼與目前不同。<input type="password">',[{t:'取消',v:false},{t:'開啟',v:true,cls:'pri'}]);
    if(!res.v)return;try{r=await decryptText(text,res.inputs[0]);}catch(e2){toast('密碼錯誤');return;}
  }
  if(r.kind!=='work'){toast('這是舊病患檔，請用「開啟舊病患檔」');return;}
  const O=r.obj,mine=new Map(S.data.patients.map(p=>[p.id,p]));
  const arch=new Set([...(S.data.archivedIds||[]),...(O.archivedIds||[])]);
  let add=0,upd=0,keep=0,skip=0;const det=[];
  (O.patients||[]).forEach(op=>{
    if(arch.has(op.id)){skip++;return;}
    const mp=mine.get(op.id);
    if(!mp){S.data.patients.push(ensurePatient(op));add++;det.push(`＋ ${op.bed||''} ${op.code||''}`);return;}
    if((op.updatedAt||'')>(mp.updatedAt||'')){Object.keys(mp).forEach(k=>delete mp[k]);Object.assign(mp,ensurePatient(op));upd++;det.push(`↻ ${op.bed||''} ${op.code||''}`);}
    else keep++;
  });
  S.data.patients=S.data.patients.filter(p=>!arch.has(p.id));
  S.data.archivedIds=[...arch];
  markDirty();renderList();renderMain();
  await modal('合併完成',`來源：${esc(fileName)}${metaTxt(O)?`（最後更新 ${esc(metaTxt(O))}）`:''}<br><br>新增 ${add} 位、以較新版本更新 ${upd} 位、保留目前版本 ${keep} 位${skip?`、略過已歸檔 ${skip} 位`:''}。${det.length?'<br><br>'+det.map(esc).join('<br>'):''}<br><br><span class="small">以「每位病人最後修改時間」決定保留哪一份。</span>`,[{t:'確定',v:true,cls:'pri'}]);
}
