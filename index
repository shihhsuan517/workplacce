    L.push(`  * aPTT ${V(g('72A038'))} sec, Factor X Assay -, INR ${V(g('72C037'))}`);
    L.push(`  * Lipid：HDL ${V(g('72A426'))} mg/dL, LDL ${V(g('72C426'))} mg/dL, T-Cholesterol ${V(g('72-305'))} mg/dL, TG ${V(g('72-310'))} mg/dL`);
