function abxDay(L,inList){
  const s=L.start||L.first,end=inList?ymd():L.last;
  return Math.floor((Date.parse(end)-Date.parse(s))/864e5)+1;
}
// 靜脈營養：PN 袋、脂肪乳劑、PN 添加物
function isPNName(t){return /\b(?:T|P)?PN\b|parenteral\s*nutrition|smoflipid|intralipid|lipofundin|omegaven|clinolipid|kabiven|olimel|nutriflex|clinimix|glycerophosphate|glycophos|peditrace|addamel|soluvit|vitalipid|cernevit|aminoven|trophamine|primene|vaminolact|有機磷/i.test(t||'');}
function pnComp(m){
  const src=(m.notes||[]).find(x=>/特調/.test(x))||((m.raw||'').match(/特調[^)]*/)||[''])[0];
  const sp=src.match(/特調\s*(.*)$/);if(!sp)return '';
  const MAP={ACE:'Acetate',NA:'Na',K:'K',MG:'Mg',CA:'Ca',P:'P',CL:'Cl',ZN:'Zn'};
  return sp[1].split(/[;；,，]/).map(x=>x.trim()).filter(Boolean).map(x=>{const q=x.match(/^([A-Za-z]+)\s*[:：]\s*([\d.]+)/);return q?`${MAP[q[1].toUpperCase()]||q[1]} ${q[2]}`:x;}).join(', ');
}
// 兒科：每公斤劑量
function pedsDoseTag(m,p){
  if(p.template!=='peds'||m.expired||m.cls==='pn')return '';
  const d=String(m.dose||'').match(/^([\d.]+)\s*(mg|mcg|g|U)$/);if(!d)return '';
  let v=parseFloat(d[1]),u=d[2];if(u==='g'){v*=1000;u='mg';}
  const wt=parseFloat(p.wt);
  const ord=(m.notes||[]).concat([m.raw||'']).join(' ').match(/([\d.]+)\s*(mg|mcg|U)\s*\/\s*kg(?:\s*\/\s*(dose|day|d|次))?/i);
  if(wt>0){const pk=v/wt;let t=`<span class="tag t-new">${fmtN(+pk.toPrecision(3))} ${u}/kg/dose</span>`;
    if(ord&&ord[2].toLowerCase()===u.toLowerCase()&&!/day|^d$/i.test(ord[3]||'')){const o=parseFloat(ord[1]);if(Math.abs(pk-o)/o>0.15)t+=`<span class="tag t-warn">醫囑寫 ${o} ${u}/kg，依目前體重應為 ${fmtN(+(o*wt).toPrecision(3))} ${u}</span>`;}
    return t;}
  if(ord&&ord[2].toLowerCase()===u.toLowerCase()&&!/day|^d$/i.test(ord[3]||''))return `<span class="tag t-warn">未填體重；依醫囑 ${ord[1]} ${u}/kg 推算約 ${fmtN(+(v/parseFloat(ord[1])).toPrecision(3))} kg</span>`;
  return '';
}
function medRow(m,p){
  const [cls,lab]=CLS_TAG[m.cls];
  let sub=m.spec;
  if(m.cls==='fluid'&&m.forDrug)sub='稀釋用：'+m.forDrug;
  if(m.isDrip)sub=`${m.qty} × ${fmtN(m.amount)} ${m.unit}${m.dilVol?` in ${m.dilName} ${m.dilVol} mL`:''}`;
  if(m.cls==='pn'){const pc=pnComp(m);sub=[m.spec,pc?'組成：'+pc:''].filter(Boolean).join(' ');}
  const notes=m.notes.length?' · '+m.notes.join(' · '):'';
  let extra=pedsDoseTag(m,p);
  if(m.abx&&!m.expired){if(m.dot)extra=`<span class="tag t-abx">DOT ${m.dot}</span>`;else{const L=p.medLog[m.key];if(L)extra=`<span class="tag t-abx">D${abxDay(L,true)}</span>`;}}
  if(m.expAt&&!m.isDrip)extra+=`<span class="tag t-reg">有效至 ${esc(m.expAt)}</span>`;
  if(m.isDrip){const c=matchDrip(m),d=c&&p.drips[c.id];
    if(c&&d){const r=computeResult(c,+d.amp,+d.dose,+d.vol,+d.flow,parseFloat(p.wt));extra=r.stage==='done'?`<span class="tag t-drip">${esc(doseSummary(c,r))}</span>`:'<span class="tag t-warn">未填流速</span>';}}
  const del=S.editMode&&!S.archive?`<button class="xdel" data-del="med" data-k="${esc(m.ordKey||'')}" data-n="${(p.medList||[]).indexOf(m)}" title="${m.ordKey?'從醫囑起迄隱藏此藥':'刪除此筆'}">✕</button> `:'';
  return `<div class="medrow ${m.cls==='exp'?'old':''}"><div><div class="mn">${del}${esc(m.display)}</div><div class="md">${esc(sub+notes)}</div></div>
    <div class="right"><b>${esc(m.dose)}</b> ${esc(m.freq)}<br><span class="tag ${cls}">${lab}</span>${extra}</div></div>`;
}
