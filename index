/* ===================== 裝置與交接 ===================== */
function deviceName(){let d='';try{d=localStorage.getItem('pw_device')||'';}catch(e){}return d||(IS_TABLET?'平板':'筆電');}
function stampMeta(){S.data.meta=Object.assign(S.data.meta||{},{updatedAt:new Date().toISOString(),device:deviceName()});}
function metaTxt(d){const m=d&&d.meta;if(!m||!m.updatedAt)return '';const t=new Date(m.updatedAt);return `${pad(t.getMonth()+1)}/${pad(t.getDate())} ${hm(t)}（${m.device||'?'}）`;}
// 檔名：原名去掉舊時間戳，加上 _MMDD-HHmm
function stampedName(){const d=new Date();const base=S.fileName.replace(/\.jcpw$/,'').replace(/(_備份)?_\d{4,8}-\d{4}$/,'');return `${base}_${pad(d.getMonth()+1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}.jcpw`;}


/* ===================== 存檔 ===================== */
let saveTimer=null;
function markDirty(){
  S.dirty=true;renderStatus();
  const cp=S.data&&!S.archive?S.data.patients.find(x=>x.id===S.selId):null;if(cp)cp.updatedAt=new Date().toISOString();
  if(S.mode==='fs'&&S.canWrite){clearTimeout(saveTimer);saveTimer=setTimeout(saveNow,700);}
}
async function saveNow(){
  if(S.mode!=='fs'||!S.canWrite||!S.handle)return;
  if(S.saving){clearTimeout(saveTimer);saveTimer=setTimeout(saveNow,400);return;}
  S.saving=true;S.dirty=false;renderStatus();
  try{
    S.data.updated=new Date().toISOString();stampMeta();
    const txt=await encryptObj(S.data,S.km,'work');
    const w=await S.handle.createWritable();await w.write(txt);await w.close();
    S.saveErr=false;S.lastSaved=new Date();
  }catch(e){S.saveErr=true;S.dirty=true;console.error(e);toast('存檔失敗：'+e.message+'（請確認隨身碟仍插著，或按「下載備份」）');}
  finally{S.saving=false;renderStatus();}
}
async function flushSave(){clearTimeout(saveTimer);if(S.dirty&&S.mode==='fs'&&S.canWrite)await saveNow();}
function renderStatus(){
  const st=$('hdStatus');st.className='status';
  if(S.mode==='sample'){st.textContent='範例模式・不存檔';return;}
  if(S.mode==='fs'&&!S.canWrite){st.textContent='唯讀';st.classList.add('err');return;}
  if(S.saveErr){st.textContent='存檔失敗';st.classList.add('err');return;}
  if(S.saving){st.textContent='儲存中…';return;}
  if(S.mode==='download'){st.textContent=S.dirty?'有未下載的變更':'已下載';if(S.dirty)st.classList.add('dirty');return;}
  if(S.dirty){st.textContent='尚未儲存';st.classList.add('dirty');return;}
  st.textContent=S.lastSaved?'已自動儲存 '+hm(S.lastSaved):'已開啟';
}
const IS_IOS=/iPad|iPhone|iPod/.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
function downloadText(text,name){
  const blob=new Blob([text],{type:'application/octet-stream'}),url=URL.createObjectURL(blob);
  if(IS_IOS){
    // iPad：加密完成後已不在點擊當下，Safari 會擋自動下載；改由使用者再點一次，並優先用「分享 → 儲存到檔案」
    let file=null;try{file=new File([blob],name,{type:'application/octet-stream'});}catch(e){}
    const canShare=!!(file&&navigator.canShare&&navigator.canShare({files:[file]}));
    modal('儲存工作檔',`<div>${esc(name)}</div>
      ${canShare?'<button class="pri" id="iosShare" style="width:100%;margin-top:12px">分享 → 儲存到「檔案」（可選 iCloud／Google Drive）</button>':''}
      <a href="${url}" download="${esc(name)}" class="btn" id="iosDl" style="display:block;text-align:center;margin-top:10px;padding:10px;border:1px solid var(--line);border-radius:10px">下載到「下載項目」</a>
      <div class="small mute" style="margin-top:8px">下載後若出現預覽頁面，點右上角分享 → 儲存到檔案。</div>`,[{t:'完成',v:true}]).then(()=>setTimeout(()=>URL.revokeObjectURL(url),60000));
    setTimeout(()=>{const b=document.getElementById('iosShare');if(b)b.onclick=async()=>{try{await navigator.share({files:[file],title:name});}catch(e){}};},0);
    return;
  }
  const a=document.createElement('a');a.href=url;
  a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);
}
$('btnDownload').onclick=async()=>{
  if(S.mode==='sample'){toast('範例模式不提供下載');return;}
  await flushSave();stampMeta();
  const name=stampedName();
  downloadText(await encryptObj(S.data,S.km,'work'),name);
  if(S.mode==='download'){S.dirty=false;S.fileName=name;$('hdFile').textContent=name;renderStatus();}
  toast('已下載加密檔：'+name+(S.mode==='download'?'。下次請開啟這個最新的檔案':''));
};
window.addEventListener('beforeunload',e=>{if(S.data&&S.dirty&&S.mode!=='sample'){e.preventDefault();e.returnValue='';}});


/* ===================== 鎖定 / 閒置 ===================== */
async function lockNow(reason){
  if(!S.data)return;
  await flushSave();
  if(S.mode==='download'&&S.dirty){
    const ok=await confirmBox('尚有未下載的變更','鎖定後這些變更會消失。要先下載工作檔嗎？','先下載');
