  if(r.concWarn)h+=`<div class="over">⚠ 超過最高濃度 ${c.maxConc} ${c.ampUnit}/mL</div>`;
  if(r.stage==='incomplete-flow')return h+'<div class="mute">輸入流速計算劑量</div>';
  r.rangesEval.forEach(x=>{
    const lab=x.label?x.label+' ':'';
    if(x.flag==='empty'){h+=`<div class="line"><span class="mute">${lab}${x.min}–${x.max} ${x.unit}</span><span class="mute">需體重</span></div>`;return;}
