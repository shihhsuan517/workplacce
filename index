<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>病患工作平台</title>
<style>
:root{
  --bg:#f4f6f9; --card:#fff; --ink:#1f2933; --mute:#5b6573; --line:#dde2e8;
  --navy:#1d3557; --navy2:#2a4a73; --accent:#3a7d6c; --accent-soft:#e3f2ee;
  --bad:#b42318; --bad-soft:#fbe5e3; --warn:#9a5c00; --warn-soft:#fcefd6; --chip:#eef2f6;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#11151b; --card:#1a1f28; --ink:#e5e9f0; --mute:#97a1b1; --line:#2b323e;
  --navy:#4f7cc0; --navy2:#6a93cf; --accent:#5bc5a8; --accent-soft:#163029;
  --bad:#f07b6f; --bad-soft:#3c1c19; --warn:#e2a646; --warn-soft:#382a11; --chip:#232a35;
}}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{background:var(--bg);color:var(--ink);font:15px/1.55 -apple-system,"Segoe UI","Noto Sans TC","Microsoft JhengHei",sans-serif}
button{font:inherit;cursor:pointer;border-radius:8px;border:1px solid var(--line);background:var(--chip);color:var(--ink);padding:7px 14px}
button:hover{filter:brightness(.96)}
button.pri{background:var(--navy);border-color:var(--navy);color:#fff}
button.danger{background:var(--bad);border-color:var(--bad);color:#fff}
button.ghost{background:transparent;border-color:transparent;color:var(--mute)}
button:disabled{opacity:.5;cursor:not-allowed}
input,select,textarea{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:7px 9px;width:100%}
textarea{resize:vertical;min-height:70px}
input:focus,select:focus,textarea:focus{outline:2px solid var(--navy2);outline-offset:-1px}
.hidden{display:none!important}
.mute{color:var(--mute)}
.small{font-size:12.5px}


/* ===== Lock screen ===== */
#lock{min-height:100%;display:flex;align-items:center;justify-content:center;padding:24px 16px}
.lockbox{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:26px 24px;width:100%;max-width:440px;box-shadow:0 6px 24px rgba(0,0,0,.06)}
.lockbox h1{margin:0 0 4px;font-size:21px;color:var(--navy)}
.lockbox .sub{font-size:13px;color:var(--mute);margin-bottom:18px}
.lockbox .stack{display:flex;flex-direction:column;gap:10px}
.lockbox label{font-size:12.5px;color:var(--mute);display:block;margin-bottom:3px}
.notice{font-size:12.5px;border-radius:8px;padding:9px 11px;margin-top:10px;line-height:1.5}
.notice.warn{background:var(--warn-soft);color:var(--warn)}
.notice.bad{background:var(--bad-soft);color:var(--bad)}
.notice.info{background:var(--accent-soft);color:var(--accent)}


/* ===== App ===== */
#app{display:flex;flex-direction:column;height:100%}
header{background:var(--navy);color:#fff;padding:10px 16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
header h1{font-size:17px;margin:0;font-weight:700}
header .file{font-size:12.5px;opacity:.85}
header .status{font-size:12px;padding:2px 9px;border-radius:999px;background:rgba(255,255,255,.15)}
header .status.dirty{background:#e8b84b;color:#3a2a00}
header .status.err{background:#f07b6f;color:#fff}
header .sp{flex:1}
header button{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.25);color:#fff;padding:5px 11px;font-size:13px}
.body{flex:1;display:flex;min-height:0}
aside{width:250px;flex:none;background:var(--card);border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
aside .top{padding:12px;display:flex;flex-direction:column;gap:8px;border-bottom:1px solid var(--line)}
aside .list{overflow-y:auto;flex:1;padding:6px}
.pitem{padding:9px 11px;border-radius:9px;cursor:pointer;margin-bottom:3px;border:1px solid transparent}
.pitem:hover{background:var(--chip)}
.pitem.on{background:var(--navy);color:#fff}
.pitem .b{font-weight:700}
.pitem .c{font-size:12.5px;opacity:.8}
.pitem.on .c{opacity:.9}
.blur{filter:blur(4px)}
main{flex:1;overflow-y:auto;padding:16px 18px 50px;min-width:0}
.empty{color:var(--mute);text-align:center;padding:70px 20px}
.phead{display:flex;align-items:flex-start;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.phead h2{margin:0;font-size:20px}
.phead .meta{font-size:13px;color:var(--mute)}
.banner{background:var(--warn-soft);color:var(--warn);border-radius:10px;padding:10px 14px;margin-bottom:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.tabs{display:flex;gap:6px;border-bottom:1px solid var(--line);margin-bottom:14px;overflow-x:auto}
.tab{padding:8px 14px;border:none;border-bottom:3px solid transparent;border-radius:0;background:none;color:var(--mute);white-space:nowrap}
.tab.on{color:var(--navy);border-bottom-color:var(--navy);font-weight:700}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:12px}
.card h3{margin:0 0 10px;font-size:15px;color:var(--navy)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px 12px}
.grid .wide{grid-column:1/-1}
.fld label{font-size:12px;color:var(--mute);display:block;margin-bottom:3px}
.kv{display:flex;justify-content:space-between;gap:8px;padding:5px 0;border-bottom:1px dashed var(--line);font-size:14px}
.kv:last-child{border-bottom:none}
.kv .k{color:var(--mute)}
.todo{border:1px dashed var(--line);border-radius:12px;padding:30px 20px;text-align:center;color:var(--mute)}


/* ===== Modal / toast ===== */
.ov{position:fixed;inset:0;background:rgba(10,20,35,.5);display:flex;align-items:center;justify-content:center;padding:18px;z-index:100}
.mbox{background:var(--card);border-radius:14px;padding:20px;width:100%;max-width:400px;box-shadow:0 12px 32px rgba(0,0,0,.3)}
.mbox h4{margin:0 0 10px;font-size:16px}
.mbox .mb{font-size:14px;color:var(--mute);margin-bottom:14px;line-height:1.55}
.mbox .mb input{margin-top:8px}
.mbox .ma{display:flex;gap:8px;justify-content:flex-end}
#toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;padding:9px 18px;border-radius:999px;font-size:13.5px;z-index:120;max-width:90vw;text-align:center}


/* ===== 一鍵貼上 ===== */
.pbox{background:var(--card);border-radius:14px;padding:18px 20px;width:100%;max-width:980px;max-height:92vh;overflow-y:auto;box-shadow:0 12px 32px rgba(0,0,0,.3)}
.pbox h4{margin:0 0 6px;font-size:17px}
.pbox textarea{min-height:170px;font-family:ui-monospace,Consolas,monospace;font-size:12.5px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.tbl{width:100%;border-collapse:collapse;font-size:13.5px}
.tbl th,.tbl td{border-bottom:1px solid var(--line);padding:6px 7px;text-align:left;vertical-align:top}
.tbl th{background:var(--chip);font-size:12.5px;color:var(--mute);font-weight:600}
.tbl td.num{white-space:nowrap}
.tblwrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px}
.tag{display:inline-block;font-size:11.5px;font-weight:600;padding:1px 8px;border-radius:999px;margin:0 4px 2px 0;white-space:nowrap}
.t-drip{background:#e8e4f8;color:#5b4b8a}
.t-abx{background:#fde8e4;color:#a63446}
.t-reg{background:var(--chip);color:var(--mute)}
.t-prn{background:#e2f1f6;color:#0e6b88}
.t-exp{background:var(--chip);color:var(--mute);text-decoration:line-through}
.t-new{background:var(--accent-soft);color:var(--accent)}
.t-warn{background:var(--warn-soft);color:var(--warn)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .t-drip{background:#2b2545;color:#b9aaf0}:root:not([data-theme="light"]) .t-abx{background:#3c1c19;color:#f3a097}:root:not([data-theme="light"]) .t-prn{background:#15313b;color:#7cc6dd}}
.secT{font-size:13px;font-weight:700;color:var(--mute);margin:14px 0 6px;letter-spacing:.03em}
.medrow{display:flex;gap:10px;align-items:flex-start;padding:8px 2px;border-bottom:1px dashed var(--line)}
.medrow:last-child{border-bottom:none}
.medrow .mn{font-weight:600}
.medrow .md{font-size:12.5px;color:var(--mute)}
.medrow .right{margin-left:auto;text-align:right;white-space:nowrap}
.medrow.old{opacity:.55}
.dgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:12px}
.dcard{background:var(--card);border:1px solid var(--line);border-left:5px solid #8874c9;border-radius:12px;padding:12px 14px}
.dcard.vp{border-left-color:#e2726a}.dcard.vd{border-left-color:#3fae95}.dcard.ar{border-left-color:#e2954f}
.dcard h4{margin:0;font-size:15px}
.dcard .src{font-size:12px;color:var(--mute);margin:2px 0 8px}
.din{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px}
.din label{font-size:11.5px;color:var(--mute);display:block}
.din .u{font-size:11px;color:var(--mute)}
.dres{background:var(--bg);border-radius:9px;padding:8px 10px;font-size:13px}
.dres .line{display:flex;justify-content:space-between;gap:8px;padding:3px 0}
.dres .v{font-family:ui-monospace,Consolas,monospace;font-weight:700}
.ok{color:var(--accent)}.over{color:var(--bad);font-weight:700}.under{color:var(--warn)}
.hist{font-size:12px;margin-top:6px}
.hist summary{cursor:pointer;color:var(--mute)}
input.sm{padding:4px 6px;width:auto}
button.small{padding:4px 10px;font-size:12.5px}
button.xdel{padding:0 6px;font-size:12px;line-height:1.5;border-radius:6px;background:var(--bad-soft);color:var(--bad);border-color:transparent}
button.link{border:none;background:none;color:var(--navy);padding:0;text-decoration:underline}
/* 呼吸治療（移植，限定在 #rtRoot 內） */
#rtRoot{--ok:#1c7a4c;--ok-soft:#e3f3ea;--grid:#e9ecf1;--accent:#0e6b88;--accent-soft:#e2f1f6}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) #rtRoot{--ok:#5bc58e;--ok-soft:#153024;--grid:#252c37;--accent:#4cb2d0;--accent-soft:#15313b}}
#rtRoot .sub{color:var(--mute);font-size:12.5px}
#rtRoot textarea{min-height:120px;font-family:ui-monospace,Consolas,monospace;font-size:12.5px}
#rtRoot .rtlog{font-size:12px;color:var(--mute);margin-top:6px;white-space:pre-wrap}
#rtRoot table{border-collapse:collapse;font-size:13px;min-width:100%}
#rtRoot th,#rtRoot td{border-bottom:1px solid var(--line);padding:4px 5px;text-align:center;white-space:nowrap}
#rtRoot th{background:var(--chip);font-weight:600;position:sticky;top:0}
#rtRoot th.grp{font-size:11px;color:var(--mute);background:var(--bg)}
#rtRoot th.calc,#rtRoot td.calc{background:var(--accent-soft)}
#rtRoot td input{width:56px;padding:3px 4px;border-radius:5px;text-align:center;background:transparent;border-color:transparent}
#rtRoot td input:hover,#rtRoot td input:focus{border-color:var(--line);background:var(--bg)}
#rtRoot td input.t{width:130px}#rtRoot td input.m{width:96px}
#rtRoot tr.sel td{outline:2px solid var(--accent);outline-offset:-2px}
#rtRoot tr[data-i]{cursor:pointer}
#rtRoot .x{border:none;background:none;color:var(--mute);padding:2px 6px}
#rtRoot button.link{border:none;background:none;color:var(--accent);padding:0;text-decoration:underline}
#rtRoot .rtgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:12px}
#rtRoot .rtgrid .card{margin:0}
#rtRoot .rtgrid .card h2{font-size:15px;margin:0 0 8px;color:var(--navy)}
#rtRoot .kv{display:flex;justify-content:space-between;gap:8px;padding:5px 0;border-bottom:1px dashed var(--line);font-size:14px}
#rtRoot .kv .k{color:var(--mute)}
#rtRoot .b{display:inline-block;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;margin-left:4px}
#rtRoot .b.ok{background:var(--ok-soft);color:var(--ok)}#rtRoot .b.warn{background:var(--warn-soft);color:var(--warn)}#rtRoot .b.bad{background:var(--bad-soft);color:var(--bad)}#rtRoot .b.na{background:var(--chip);color:var(--mute)}
#rtRoot .note{font-size:12px;color:var(--mute);margin-top:6px}
#rtRoot ul.h{margin:4px 0 0;padding-left:20px}#rtRoot ul.h li{margin:4px 0}
#rtRoot .chk{display:flex;gap:8px;align-items:flex-start;padding:4px 0;font-size:14px}
#rtRoot .chk input{width:auto}
#rtRoot .charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:10px}
#rtRoot .chart{border:1px solid var(--line);border-radius:8px;padding:6px 8px}
#rtRoot .chart .t{font-size:12px;color:var(--mute);display:flex;justify-content:space-between}
#rtRoot svg text{fill:var(--mute);font-size:10px}
#rtRoot pre.out{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px;white-space:pre-wrap;font-size:13px;margin:8px 0 0}
#rtRoot label.sub input[type=checkbox]{width:auto}
/* 藥敏 */
.sir{font-weight:700}.sir-S{color:var(--accent)}.sir-I{color:var(--warn)}.sir-R{color:var(--bad)}.sir-D{color:#0e6b88}
/* 檢驗表 */


.tpnkv .k{white-space:nowrap;margin-right:10px}
.issuebar{background:var(--warn-soft);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin-bottom:12px}
.issue{display:flex;gap:8px;align-items:flex-start;background:var(--card);border-radius:8px;padding:7px 10px;margin-top:6px}
.issue.done{opacity:.7}
details.lgroup{background:var(--card);border:1px solid var(--line);border-radius:12px;margin-bottom:10px;overflow:hidden}
details.lgroup summary{list-style:none;cursor:pointer;padding:9px 14px;background:var(--chip);font-weight:700;color:var(--navy);display:flex;align-items:center;justify-content:space-between;gap:8px}
details.lgroup summary::-webkit-details-marker{display:none}
details.lgroup summary::before{content:"▸";margin-right:6px;transition:transform .15s}
details.lgroup[open] summary::before{transform:rotate(90deg)}
table.ltbl{border-collapse:collapse;font-size:13px;width:100%}
table.ltbl th,table.ltbl td{border:1px solid var(--line);padding:5px 8px;text-align:center;white-space:nowrap}
table.ltbl th{background:var(--chip);font-size:11.5px;color:var(--mute);line-height:1.25}
table.ltbl .litem{position:sticky;left:0;background:var(--card);z-index:1;text-align:left;min-width:130px}
table.ltbl th.litem{background:var(--chip);z-index:2}
table.ltbl td.lref{color:var(--mute);font-size:11.5px;text-align:left;white-space:normal;min-width:120px}
.lh{color:var(--bad);font-weight:700}.ll{color:#1f6fb2;font-weight:700}.lempty{color:var(--line)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .ll{color:#7cb6ea}}
tr.ghead td{background:var(--chip);border-bottom:none}
tr.old td{opacity:.5;text-decoration:line-through}
/* 起迄時間軸 */
.gantt{font-size:12px;border:1px solid var(--line);border-radius:10px;padding:6px 8px;overflow-x:auto}
.grow{display:grid;grid-template-columns:190px minmax(420px,1fr);align-items:center;min-height:22px;border-bottom:1px dashed var(--line)}
.grow:last-child{border-bottom:none}
.gaxis{border-bottom:1px solid var(--line);min-height:20px}
.gname{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:8px}
.gtrack{position:relative;height:22px}
.gaxis .gtrack{height:18px}
.gtick{position:absolute;top:1px;transform:translateX(-2px);font-size:10.5px;color:var(--mute);white-space:nowrap;font-family:ui-monospace,Consolas,monospace}
.gline{position:absolute;top:0;bottom:0;border-left:1px solid var(--line)}
.gnow{position:absolute;top:0;bottom:0;border-left:2px solid var(--accent)}
.gbar{position:absolute;top:6px;height:10px;border-radius:3px;background:#7b8794}
.gbar.abx{background:#c0574b}.gbar.drip{background:#7b68c4}
.gbar.open{opacity:1}.gbar.stopped{opacity:.8}
.gbar.expired{opacity:.55;border-right:2px dashed var(--ink)}
.gbar.once{width:8px!important;height:8px;top:7px;border-radius:50%;transform:translateX(-4px)}


@media (max-width:720px){
  .body{flex-direction:column}
  aside{width:auto;max-height:38vh;border-right:none;border-bottom:1px solid var(--line)}
}
</style>
</head>
<body>


<!-- ======================= 鎖定 / 開啟畫面 ======================= -->
<div id="lock">
  <div class="lockbox">
    <h1>病患工作平台</h1>
    <div class="sub">資料只存在你開啟的加密工作檔中，不上傳任何伺服器，瀏覽器也不留存。</div>


    <!-- 首頁 -->
    <div id="lkHome" class="stack">
      <button class="pri" id="btnOpen">開啟工作檔</button>
      <button id="btnNew">建立新工作檔</button>
      <button class="ghost" id="btnSample">試用範例資料（虛構病人，不存檔）</button>
      <div id="fsNotice"></div>
      <div id="envCheck" class="small mute"></div>
    </div>


    <!-- 解鎖 -->
    <div id="lkUnlock" class="stack hidden">
      <div class="small mute">工作檔：<b id="lkFileName"></b></div>
      <div><label for="pwUnlock">密碼</label><input type="password" id="pwUnlock" autocomplete="current-password"></div>
      <button class="pri" id="btnUnlock">解鎖</button>
      <button class="ghost" id="btnBack1">改開其他檔案</button>
      <div id="unlockMsg"></div>
    </div>


    <!-- 建立 -->
    <div id="lkCreate" class="stack hidden">
      <div><label for="pwNew1">設定密碼</label><input type="password" id="pwNew1" autocomplete="new-password"></div>
      <div><label for="pwNew2">再輸入一次</label><input type="password" id="pwNew2" autocomplete="new-password"></div>
      <div id="pwStrength"></div>
      <button class="pri" id="btnCreate">選擇存檔位置並建立</button>
      <button class="ghost" id="btnBack2">返回</button>
      <div class="notice warn">忘記密碼就無法打開工作檔，沒有任何救回方式。請把密碼另外記在安全的地方。</div>
      <div id="createMsg"></div>
    </div>
  </div>
</div>


<!-- ======================= 主畫面 ======================= -->
<div id="app" class="hidden">
  <header>
    <h1>病患工作平台</h1>
    <span class="file" id="hdFile"></span>
    <span class="status" id="hdStatus"></span>
    <span class="sp"></span>
    <button id="btnDownload" title="下載一份加密備份">下載備份</button>
    <button id="btnOpenArchive">開啟舊病患檔</button>
    <button id="btnUndo" class="hidden">↶ 復原</button>
    <button id="btnMerge" title="把另一台裝置存回的工作檔合併進來">合併工作檔</button>
    <button id="btnChangePw">變更密碼</button>
    <button id="btnLock">鎖定</button>
  </header>
  <div class="body">
    <aside>
      <div class="top">
        <button class="pri" id="btnPaste">📋 一鍵貼上病人資料／醫囑</button>
        <button id="btnAddPt">＋ 手動新增病患</button>
        <input id="ptSearch" placeholder="搜尋床號、代號、姓名…">
        <label class="small mute" style="display:flex;gap:6px;align-items:center">
          <input type="checkbox" id="chkHide" style="width:auto"> 遮蔽姓名與病歷號
        </label>
      </div>
      <div class="list" id="ptList"></div>
      <div class="small mute" style="padding:8px 12px;border-top:1px solid var(--line)" id="ptCount"></div>
    </aside>
    <main id="main"></main>
  </div>
</div>


<div id="modal" class="ov hidden"><div class="mbox"><h4 id="mT"></h4><div class="mb" id="mB"></div><div class="ma" id="mA"></div></div></div>
<div id="pasteOv" class="ov hidden"><div class="pbox">
  <h4>一鍵貼上病人資料／醫囑</h4>
  <div class="small mute" style="margin-bottom:8px">把 HIS 的病人資訊列與醫囑整段貼上（可以只貼其中一種）。解析後先預覽，確認才匯入。</div>
  <textarea id="pasteText" placeholder="病歷號:… 姓名:… 年齡:… 床號 入院日期:…&#10;Esomeprazole mups 40mg/tab   1PC QD&#10;Midazolam 15mg/3mL/amp (管4)(in NS 250 run as order)   10PC IRRE&#10;…"></textarea>
  <div class="row" style="margin-top:8px">
    <button class="pri" id="btnParsePaste">解析</button>
    <button id="btnClosePaste">取消</button>
  </div>
  <div id="pastePreview"></div>
</div></div>
<div id="toast" class="hidden"></div>
