const ABX_WORDS=['piperacillin','tazobactam','azithromycin','clarithromycin','erythromycin','ceftriaxone','cefazolin','cefepime','ceftazidime','cefuroxime','cefoperazone','cefmetazole','cefotaxime','ceftaroline','ceftolozane','avibactam','flomoxef','cephalexin','cefixime','cefiderocol','meropenem','imipenem','ertapenem','doripenem','vancomycin','teicoplanin','linezolid','tedizolid','daptomycin','levofloxacin','ciprofloxacin','moxifloxacin','ampicillin','sulbactam','amoxicillin','clavulan','oxacillin','penicillin','gentamicin','amikacin','tobramycin','colistin','polymyxin','tigecycline','eravacycline','minocycline','doxycycline','clindamycin','metronidazole','sulfamethoxazole','trimethoprim','baktar','fluconazole','voriconazole','posaconazole','isavuconazole','micafungin','anidulafungin','caspofungin','amphotericin','acyclovir','ganciclovir','oseltamivir','peramivir','remdesivir','rifampin','rifampicin','isoniazid','ethambutol','pyrazinamide','fosfomycin','aztreonam'];
const UNIT_RE='(mg|mcg|µg|μg|ug|gm|g|units?|IU|U)';
function normUnit(u){u=(u||'').toLowerCase();if(u==='gm')return 'g';if(['µg','μg','ug'].includes(u))return 'mcg';if(['iu','u','unit','units'].includes(u))return 'U';if(u==='ml')return 'mL';return u;}
function fmtN(n){if(n==null||n===''||isNaN(n))return '';n=+n;const a=Math.abs(n);return String(+n.toFixed(a>=100?1:a>=1?2:a>=0.1?3:4));}
const capFirst=s=>s?s[0].toUpperCase()+s.slice(1):s;


function isHeaderLine(l){return /(病歷號|姓名|入院日期?|床號)\s*[:：]/.test(l);}
function parseHeaderLine(line){
  const h={},g=re=>{const m=line.match(re);return m?m[1].trim():'';};
  h.chartNo=g(/病歷號\s*[:：]\s*(\S+)/);
  h.name=g(/姓名\s*[:：]\s*(.+?)(?=\s+(?:年齡|性別|床號?|入院日期?|病歷號)\s*[:：]|\s{3,}|$)/).replace(/\s+/g,' ');
  const age=g(/年齡\s*[:：]\s*(\S+)/);
  if(age){const n=age.match(/^(\d+(?:\.\d+)?)\s*歲?$/);if(n)h.age=n[1];else h.ageText=age;}
  const sex=g(/性別\s*[:：]\s*(\S+)/);if(sex)h.sex=/^(男|M)/i.test(sex)?'M':/^(女|F)/i.test(sex)?'F':'';
  const ad=g(/入院日期?\s*[:：]\s*([\d\/\-.]+)/);
  if(ad){const m=ad.match(/(\d{2,4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})/);if(m){let y=+m[1];if(y<1911)y+=1911;h.admitDate=`${y}-${pad(m[2])}-${pad(m[3])}`;}}
  h.wt=g(/體重\s*[:：]\s*([\d.]+)/);h.ht=g(/身高\s*[:：]\s*([\d.]+)/);
  let bed=g(/床號?\s*[:：]\s*(\S+)/);
  if(!bed){
    const rest=line.replace(/[^\s:：]+\s*[:：]\s*\S*/g,' ').trim().split(/\s+/).filter(Boolean);
    bed=rest.find(t=>/^[A-Za-z0-9\-]{3,12}$/.test(t)&&/[A-Za-z]/.test(t)&&/\d/.test(t))||'';
  }
  h.bed=bed;
  for(const k in h)if(!h[k])delete h[k];
  return h;
}


function parseMedLine(raw){
  const line=raw.replace(/\s+$/,'');
  const QU='(PC|PCS|TAB|CAP|AMP|VIAL|BOT|BAG|PK|SUP|DOSE|ML|UN|IU|U|MG|MCG|UG|GM|G|KU|MU|PU|DS|QS)';
  let t=line.match(new RegExp('^(.*\\S)\\s+(\\d+(?:\\.\\d+)?)\\s*'+QU+'?\\s+([A-Za-z0-9]{1,10})\\s*$','i'));
  let freq='';
  if(t)freq=t[4].toUpperCase();
  else{t=line.match(new RegExp('^(.*\\S)\\s+(\\d+(?:\\.\\d+)?)\\s*'+QU+'\\s*$','i'));if(!t)return null;}
  let desc=t[1].trim();
  const qty=parseFloat(t[2]),qunit=(t[3]||'PC').toUpperCase();
  let tag='';const tm=desc.match(/^\[([^\]]+)\]\s*/);if(tm){tag=tm[1];desc=desc.slice(tm[0].length);}
  // 拆括號（含巢狀）
  const parens=[];let spec=desc,guard=0;
  while(/\([^()]*\)/.test(spec)&&guard++<10)spec=spec.replace(/\(([^()]*)\)/g,(_,x)=>{parens.push(x.trim());return ' ';});
  spec=spec.replace(/\s+/g,' ').trim();
  // 藥名：去掉括號內容後，取到第一個劑量規格（數字或 / 開頭）之前，例如 Regular (Actrapid) HM insulin 100iu/mL → Regular HM insulin
  let name=spec.split(/\s(?=[\d\/])/)[0].replace(/[,，]\s*$/,'').trim();
  if(!name||/^[\d\/]/.test(name))name=desc.split(/\(|\s(?=\d)/)[0].trim();
  let generic=parens.find(x=>/\b[A-Z]{5,}\b/.test(x)&&!/[一-鿿]/.test(x))||'';
  if(!generic){const cb=parens.find(x=>/[A-Za-z]{4,}\s*[\d.]+\s*(mg|g|gm|mcg)?\s*\+\s*[A-Za-z]{4,}/i.test(x)&&!/[一-鿿]/.test(x));if(cb)generic=cb;}
  const genericClean=generic?generic.replace(/\s*[\d.]+\s*(mg|gm|g|mcg|U|IU)\b/gi,'').replace(/\s*\+\s*/g,'/').trim().toLowerCase():'';
  // 每支劑量與每支體積
  let amount=null,unit='',ampVol=null,m;
  const CONT='(amp|vial|bot|bag|pc)';
  if((m=spec.match(new RegExp('([\\d.]+)\\s*'+UNIT_RE+'\\s*\\/\\s*(?:([\\d.]+)\\s*)?mL\\s*,\\s*([\\d.]+)\\s*mL\\s*\\/\\s*'+CONT,'i')))){
    amount=parseFloat(m[1])/(m[3]?parseFloat(m[3]):1)*parseFloat(m[4]);unit=normUnit(m[2]);ampVol=parseFloat(m[4]);
  }else if((m=spec.match(new RegExp('([\\d.]+)\\s*'+UNIT_RE+'\\s*\\/\\s*([\\d.]+)\\s*mL\\s*\\/\\s*'+CONT,'i')))){
    amount=parseFloat(m[1]);unit=normUnit(m[2]);ampVol=parseFloat(m[3]);
  }else if((m=spec.match(new RegExp('([\\d.]+)\\s*'+UNIT_RE+'(?![A-Za-z])','i')))){
    amount=parseFloat(m[1]);unit=normUnit(m[2]);
  }
  if(ampVol==null){const v=spec.match(/([\d.]+)\s*mL\s*\/\s*(amp|vial|bot|bag)/i);if(v)ampVol=parseFloat(v[1]);}
  const pc=parens.map(x=>x.match(new RegExp('^([\\d.]+)\\s*'+UNIT_RE+'\\s*(?:\\/\\s*(?:pc|amp|vial|tab|cap)|base)$','i'))).find(Boolean);
  if(pc){amount=parseFloat(pc[1]);unit=normUnit(pc[2]);}
  const dm=desc.match(/in\s*(N\/S|N\.S\.?|NS|D5W|D5S|D10W|D5NS)\s*(\d+)\s*(?:ml|cc)?/i);
  const dilName=dm?dm[1].toUpperCase().replace(/[\/.]/g,''):'';
  const dilVol=dm?parseFloat(dm[2]):null;
  const pn=isPNName(desc);
  const isDrip=!pn&&freq==='IRRE'&&(!!dm||/run as order/i.test(desc));
  const prn=freq==='PRN'||parens.some(x=>/\bPRN\b/i.test(x));
  const once=['ONCE','STAT','ST'].includes(freq);
  const expired=/到期|停|DC/i.test(tag);
  const hay=(name+' '+generic+' '+desc).toLowerCase();
  const abx=ABX_WORDS.some(w=>hay.includes(w));
  const diluent=/^(D5W|D10W|D5S|D5NS|N\/?S|NS|0\.45%|0\.9%|Normal saline|Sodium chloride 0\.9|Glucose 5%|Dextrose 5%)\b/i.test(name)&&parens.some(x=>/^for\s+\S/i.test(x));
  const forDrug=diluent?(parens.find(x=>/^for\s+\S/i.test(x))||'').replace(/^for\s+/i,''):'';
  const cls=expired?'exp':pn?'pn':diluent?'fluid':isDrip?'drip':abx?'abx':prn?'prn':once?'once':'reg';
  const pnCode=pn?(parens.find(x=>/^[A-Z]\d+(?:\.\d+)?$/.test(x))||''):'';
  const notes=parens.filter(x=>x!==generic&&!/^管\d+$/.test(x)&&!/^[\d.]+\s*(mg|g|mcg)\s*\/\s*pc$/i.test(x));
  const display=genericClean&&!name.toLowerCase().includes(genericClean.split('/')[0])?`${name} (${capFirst(genericClean)})`:name;
  const key=(genericClean||name).toLowerCase().replace(/\s+/g,' ').trim();
  const tot=amount!=null?amount*qty:null;
  const QUN={UN:'U',IU:'U',U:'U',MG:'mg',MCG:'mcg',UG:'mcg',GM:'g',G:'g',ML:'mL',KU:'kU',MU:'MU'};
  const contU=(spec.match(/\/\s*(amp|vial|bot|bag)\b/i)||[])[1];
  const dose=QUN[qunit]?`${fmtN(qty)} ${QUN[qunit]}`:pn&&contU&&qunit==='PC'?`${fmtN(qty)} ${contU.toLowerCase()}`:amount!=null?(unit==='mg'&&tot>=1000?`${fmtN(tot/1000)} g`:`${fmtN(tot)} ${unit}`):`${fmtN(qty)} ${qunit==='PC'?'pc':qunit.toLowerCase()}`;
  return {raw:line.trim(),tag,expired,name,generic,display,forDrug,key,spec:spec.slice(name.length).trim(),notes,
    amount,unit,ampVol,qty,qunit,freq,dose,isDrip,dilName,dilVol,prn,once,abx,cls,pn,pnCode,cont:(spec.match(/\/\s*(amp|vial|bot|bag|pk|tab|cap)\b/i)||[])[1]||''};
}


function parsePaste(txt){
  const res={header:{},meds:[],unknown:[]};
  txt.replace(/\r/g,'').split('\n').map(l=>l.replace(/ /g,' ')).forEach(l=>{
    if(!l.trim())return;
    if(isHeaderLine(l)){Object.assign(res.header,parseHeaderLine(l));return;}
    const m=parseMedLine(l);
    if(m)res.meds.push(m);else res.unknown.push(l.trim());
  });
  return res;
}


/* ===================== 匯入 ===================== */
function convertAmt(v,from,to){
  const F={g:1e6,mg:1e3,mcg:1,'µg':1};
  if(from===to||!F[from]||!F[to])return v;
  return +(v*F[from]/F[to]).toFixed(4);
}
function calcDripVol(d){
  if(d.dil==null||d.dil==='')return d.vol??'';
  const extra=S.data.settings.dripInclDrugVol&&d.ampVol?(+d.amp)*d.ampVol:0;
  return +((+d.dil)+extra).toFixed(1);
}
function matchDrip(m){return DRIP_CFG.find(c=>c.match.test(m.name+' '+(m.generic||'')));}
function syncDrips(p,meds){
  const today=ymd(),seen=new Set();let n=0;
  meds.filter(m=>m.isDrip&&!m.expired).forEach(m=>{
    const c=matchDrip(m);if(!c)return;
    seen.add(c.id);n++;
    const old=p.drips[c.id];
    const nv={amp:m.qty,dose:m.amount!=null?convertAmt(m.amount,m.unit,c.ampUnit):c.ampDefault,
      dil:m.dilVol,dilName:m.dilName,ampVol:m.ampVol??c.ampVol,fromOrder:true,inOrder:true};
    nv.vol=calcDripVol(nv);
    if((nv.vol===''||nv.vol==null)&&old&&old.vol)nv.vol=old.vol;   // 醫囑沒寫稀釋量時保留手動輸入
    const changed=old&&(+old.amp!==+nv.amp||+old.dose!==+nv.dose||+old.vol!==+nv.vol);
    const d=Object.assign(old||{flow:''},nv,{changedAt:changed?today:(old&&old.changedAt)||''});
    if(!d.flow&&m.flowHint)d.flow=m.flowHint;
    p.drips[c.id]=d;
  });
  Object.keys(p.drips).forEach(id=>{if(!seen.has(id)&&p.drips[id].fromOrder)p.drips[id].inOrder=false;});
  return n;
}


function importParsed(res,targetId){
  const today=ymd();
  let p=targetId&&targetId!=='new'?S.data.patients.find(x=>x.id===targetId):null;
  const isNew=!p;
  if(!p){p=newPatient();S.data.patients.push(p);}
  ensurePatient(p);
  Object.entries(res.header).forEach(([k,v])=>{if(v)p[k]=v;});
  if(res.header.ageText&&!res.header.age)p.age='';
  if(p.ageText)p.ageText=normAgeText(p.ageText);
  { const ay=ageYears(p);
    if(ay!=null&&ay<18&&(isNew||p.template==='adult')){p.template='peds';res.autoPeds=true;
      if(p.age!==''&&p.age!=null&&!p.ageText){p.ageText=p.age+' 歲';}}}
  let dripN=0;
  if(res.meds.length){
    p.medList=res.meds.map(m=>Object.assign({},m));
    p.medPasteAt=new Date().toISOString();
    res.meds.forEach(m=>{
      const L=p.medLog[m.key];
      if(!L)p.medLog[m.key]={name:m.display,first:today,last:today,abx:m.abx,start:''};
      else{L.last=today;L.name=m.display;L.abx=L.abx||m.abx;}
    });
    dripN=syncDrips(p,res.meds);
  }
  p.updatedAt=new Date().toISOString();
  return {p,isNew,dripN,autoPeds:!!res.autoPeds};
}


