function soapCtx(p){
  const all=hasLabs(p)?Object.keys(p.labs.cols).sort().reverse():[];
  const newestDay=all.length?all[0].slice(0,8):'';
  // 數值：與最新一次檢驗不同日的，標註日期
  const V=(v,dec)=>{if(!v)return '-';let s=String(v.value).replace(/\s*\(.*?\)\s*/g,'').trim();if(dec!=null&&!isNaN(parseFloat(s))&&/^[\d.]+$/.test(s))s=String(+parseFloat(s).toFixed(dec));return s+(v.sk.slice(0,8)!==newestDay?`(${skMD(v.sk)})`:'');};
  const g=(code,st='B')=>latestLab(p,code,st);
  return {V,g,newestDay,band:labByName(p,/band/i),renal:renalCalc(p)};
}
function crclTxt(r){
  if(!r)return '-';
  if(r.peds)return '-';
  if(r.crcl==null)return '-';
  return `${r.crcl.toFixed(1)}${r.adj!=null?` (AdjBW ${r.adj.toFixed(1)})`:''}`;
}
function soapLabLines(p,kind){
