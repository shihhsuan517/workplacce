}


// 體重換算：BMI（國健署分級）、IBW（Devine，= ARDSnet PBW）、AdjBW = IBW + 0.4 ×（TBW − IBW）
function bodyW(p){
  const ht=parseFloat(p.ht),wt=parseFloat(p.wt),peds=p.template==='peds',r={peds};
  if(ht>0&&wt>0){r.bmi=wt/((ht/100)**2);
    r.cat=peds?'兒童請對照年齡別百分位':r.bmi<18.5?'過輕':r.bmi<24?'正常':r.bmi<27?'過重':r.bmi<30?'輕度肥胖':r.bmi<35?'中度肥胖':'重度肥胖';
    r.catCls=peds?'mute':r.bmi<18.5||r.bmi>=27?'over':r.bmi>=24?'under':'ok';}
  if(!peds&&ht>0&&p.sex){const ibw=(p.sex==='M'?50:45.5)+0.91*(ht-152.4);
    if(ibw>0){r.ibw=ibw;r.short=ht<152.4;
      if(wt>0){r.pct=wt/ibw*100;r.adj=ibw+0.4*(wt-ibw);
        r.dose=wt<ibw?{w:wt,t:'TBW（實際體重低於 IBW）'}:r.pct<=120?{w:ibw,t:'IBW（TBW ≤120% IBW，亦可用 TBW，依藥品）'}:{w:r.adj,t:'AdjBW（TBW >120% IBW）'};}}}
  return r;
}
const bwMeta=p=>{const b=bodyW(p),a=[];if(b.bmi)a.push('BMI '+b.bmi.toFixed(1));if(b.ibw)a.push('IBW '+b.ibw.toFixed(1));if(b.adj!=null&&b.pct>100)a.push('AdjBW '+b.adj.toFixed(1));return a.join(' · ');};
function calcBody(p){
  const ht=parseFloat(p.ht),wt=parseFloat(p.wt),out=[],b=bodyW(p);
  if(wt)out.push(['TBW（實際體重）',wt+' kg']);
  if(b.bmi)out.push(['BMI',`<b>${b.bmi.toFixed(1)}</b> kg/m² <span class="${b.catCls}">${b.cat}</span>`]);
  if(b.ibw){
    out.push(['IBW（Devine）＝ PBW',`<b>${b.ibw.toFixed(1)}</b> kg${b.pct!=null?` <span class="small mute">TBW 為 IBW 的 ${b.pct.toFixed(0)}%</span>`:''}${b.short?' <span class="small under">身高 <152.4 cm，公式準確度下降</span>':''}`]);
    if(b.adj!=null)out.push(['AdjBW（ABW）',`<b>${b.adj.toFixed(1)}</b> kg${b.pct<=100?' <span class="small mute">TBW ≤ IBW，通常不使用</span>':''}`]);
    if(b.dose)out.push(['建議給藥體重',`<b>${b.dose.w.toFixed(1)}</b> kg <span class="small mute">${b.dose.t}</span>`]);
    out.push(['Vt 6–8 mL/kg PBW',`${(b.ibw*6).toFixed(0)}–${(b.ibw*8).toFixed(0)} mL`]);
  }else if(!b.peds&&ht&&!p.sex)out.push(['IBW／AdjBW','需選性別']);
  if(p.template==='peds'){const dd=dobDays(p),g=gaDays(p);
    if(dd!=null)out.push(['生後日數（PNA）',`${dd} 天${dd<28?'（新生兒期）':''}`]);
    if(g!=null)out.push(['GA／PMA',`${wkTxt(g)} 週${dd!=null?`／PMA <b>${pmaTxt(p)}</b> 週`:'（填出生日期可算 PMA）'}`]);
    if(p.birthWt&&wt)out.push(['體重變化（對出生體重）',`${(wt*1000-p.birthWt)>=0?'+':''}${Math.round(wt*1000-p.birthWt)} g（${((wt*1000/p.birthWt-1)*100).toFixed(1)}%）`]);}
  if(p.wtSrc&&wt)out.push(['體重來源',esc(p.wtSrc)]);
  if(p.template==='peds'&&wt&&ht)out.push(['BSA (Mosteller)',Math.sqrt(ht*wt/3600).toFixed(2)+' m²']);
  const r=renalCalc(p);
  if(r){
    const src=`Cr ${r.scr} mg/dL（${skMD(r.crSk)}）`;
    if(r.peds)out.push(['eGFR（Brion, k='+r.peds.k+'）',`${r.peds.egfr.toFixed(1)} mL/min/1.73m² ${src}`]);
    else if(r.crcl!=null){
      out.push(['CrCl（Cockcroft-Gault，實際體重）',`${r.crcl.toFixed(1)} mL/min ${src}`]);
      if(r.adj!=null)out.push(['CrCl（AdjBW）',`${r.adj.toFixed(1)} mL/min`]);
    }else out.push(['CrCl',`需年齡、性別、體重 ${src}`]);
  }
  return out;
}


