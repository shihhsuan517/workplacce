function medsSoapText(p){
  const order=['drip','pn','abx','reg','prn','once'],inList=true;
  const act=(p.medList||[]).filter(m=>!m.expired&&m.cls!=='fluid').sort((a,b)=>order.indexOf(a.cls)-order.indexOf(b.cls));
  return act.map(m=>{
    let s=`${m.display} ${m.dose}${m.route?' '+m.route:''} ${m.freq}`;
    if(m.isDrip){
      const c=matchDrip(m),d=c&&p.drips[c.id];
      s=`${m.display} ${fmtN(m.qty)} amp${m.dilVol?` in ${m.dilName} ${m.dilVol} mL`:''}`;
      if(c&&d&&d.flow){const r=computeResult(c,+d.amp,+d.dose,+d.vol,+d.flow,parseFloat(p.wt));s+=`, run ${d.flow} mL/hr`+(r.stage==='done'?` (${doseSummary(c,r)})`:'');}
      else s+=', run as order';
    }
    if(m.cls==='pn'){const pc=pnComp(m);s=`${m.display}${m.pnCode?' ('+m.pnCode+')':''} ${m.dose}${m.freq==='IRRE'?', run as order':' '+m.freq}${pc?` [${pc}]`:''}`;}
    if(m.abx){if(m.dot)s+=` (D${m.dot}${m.courseStart?`, since ${m.courseStart.slice(5).replace('-','/')}`:''})`;else{const L=p.medLog[m.key];if(L)s+=` (D${abxDay(L,inList)})`;}}
    if(m.prn){const n=m.notes.filter(x=>!/[一-鿿]/.test(x)).map(x=>x.replace(/^PRN\s*,?\s*/i,'')).filter(Boolean);if(n.length)s+=` (${n.join('; ')})`;}
    return '- '+s.replace(/\s+/g,' ').trim();
  }).join('\n');
}
async function copyText(text){
  try{await navigator.clipboard.writeText(text);return true;}
  catch(e){const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.left='-9999px';document.body.appendChild(ta);ta.select();let ok=false;try{ok=document.execCommand('copy');}catch(_){}ta.remove();return ok;}
}
