  };
  text.split(/\r?\n/).forEach(raw=>{
    const line=raw.replace(/\s+$/,"");
    // D header: 列印時間 (patient identifiers on this line are never kept)
    let m=line.match(/列印時間[:：]\s*(\d{4})\/(\d{1,2})\/(\d{1,2})\s+(\d{1,2}):(\d{2})/);
    if(m){ curT=new Date(+m[1],+m[2]-1,+m[3],+m[4],+m[5]); inDrug=false; pending=null; last=null; sheets++; sheetTimes.push(curT); curSheet={t:curT,drugs:[],other:[]}; sheetInfo.push(curSheet); return; }
    if(curT){
      if(/^類別\s+藥品名稱/.test(line)){ inDrug=true; pending=null; return; }
      if(/^類別\s/.test(line) || /醫師[:：]/.test(line) || !line.trim()){ if(pending){unrec.push("（無法解析的藥品行）"+pending.name);} inDrug=false; pending=null; return; }
      if(inDrug){
        const cm=line.match(D_CAT);
