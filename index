S.undo=[];
function snapshot(p,label){S.undo.push({pid:p.id,json:JSON.stringify(p),label,idx:S.data.patients.indexOf(p)});if(S.undo.length>20)S.undo.shift();renderUndo();}
function renderUndo(){const b=$('btnUndo');if(!b)return;const u=S.undo[S.undo.length-1];b.classList.toggle('hidden',!u);if(u)b.textContent=`↶ 復原（${u.label}）`;}
$('btnUndo').onclick=()=>{
  const u=S.undo.pop();if(!u||!S.data)return;
  const old=JSON.parse(u.json),cur=S.data.patients.find(x=>x.id===u.pid);
  if(cur){Object.keys(cur).forEach(k=>delete cur[k]);Object.assign(cur,old);}
