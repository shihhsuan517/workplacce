  ['midazolam','cisatracurium','fentanyl'].forEach(id=>logDrip(p1,id));
  mergeLabs(p1,parseLab(SAMPLE_LAB));
  RT.importInto(p1,RT.SAMPLE);p1.rt.rass='-4';
  mergeMicro(p1,parseMicro(SAMPLE_MICRO));
  const p2=S.data.patients[1];
  p2.orderSources=[{addedAt:new Date().toISOString(),text:SAMPLE_SHEET}];
  deriveFromOrders(p2);
