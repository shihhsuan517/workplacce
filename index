const EXAM_TYPES=[['CT',/\bCT\b|computed\s*tomograph|電腦斷層/i],['MRI',/\bMRI\b|\bMRA\b|magnetic\s*resonance|核磁/i],
  ['超音波',/echo|sono|ultrasound|超音波|doppler|duplex/i],['心電圖',/\bEKG\b|\bECG\b|心電圖|holter/i],
  ['內視鏡',/endoscop|gastroscop|colonoscop|bronchoscop|\bEGD\b|\bPES\b|內視鏡|支氣管鏡|胃鏡|大腸鏡/i],
  ['核醫',/scintig|\bSPECT\b|\bPET\b|核醫|bone\s*scan|thallium|gallium/i],['病理',/patholog|biopsy|cytolog|病理|切片|細胞學/i],
  ['X光',/x-?ray|\bview\b|\bCXR\b|\bKUB\b|portable|radiograph|X光|chest\s*(?:a-?p|p-?a)\b|\bL-?spine|\bskull\b/i]];
const EXAM_TYPE_NAMES=EXAM_TYPES.map(x=>x[0]).concat(['其他']);
const EXAM_KEY=/^\s*(檢查日期|執行日期|報告日期|檢查時間|檢查項目|檢查名稱|醫令名稱|檢查單號|申請單號|Exam(?:ination)?\s*(?:Date|Name|Item)|Procedure)\s*[:：]/i;
const EXAM_TITLE=/(?:檢查項目|檢查名稱|醫令名稱|Exam(?:ination)?\s*(?:Name|Item)|Procedure)\s*[:：]\s*([^\n]+)/i;
const EXAM_IMP=/^\s*(?:\*\s*)?(impression|imp\.?|conclusion|結論|印象|診斷|summary|interpretation|判讀)\s*[:：]?\s*/i;
const EXAM_END=/(報告醫師|確認醫師|審核醫師|判讀醫師|Reported\s*by|Verified\s*by|打字|^\s*[-=_]{6,}\s*$)/i;
function toISODate(s){
  if(!s)return '';let m=s.match(/(\d{3,4})[\/\-.年](\d{1,2})[\/\-.月](\d{1,2})(?:日)?(?:\s+(\d{1,2}):(\d{2}))?/);
  if(!m){m=s.match(/\b(20\d{2})(\d{2})(\d{2})(?:\s*(\d{2}):?(\d{2}))?\b/);}
  if(!m)return '';let y=+m[1];if(y<1911)y+=1911;
  return `${y}-${pad(+m[2])}-${pad(+m[3])}${m[4]!=null?` ${pad(+m[4])}:${m[5]}`:''}`;
}
const examType=t=>{const x=EXAM_TYPES.find(([,re])=>re.test(t||''));return x?x[0]:'其他';};
function parseExams(text){
  const lines=String(text||'').replace(/\r/g,'').split('\n');
  // 以第一個出現的表頭欄位當作每份報告的起點
  let startKey=null;const starts=[];
  lines.forEach((l,i)=>{const m=l.match(EXAM_KEY);if(!m)return;const k=m[1].replace(/\s+/g,'').toLowerCase();if(!startKey)startKey=k;if(k===startKey)starts.push(i);});
  let blocks=[];
  if(starts.length>1){starts.forEach((s,j)=>blocks.push(lines.slice(j?s:0,starts[j+1]??lines.length).join('\n')));}
  else blocks=[lines.join('\n')];
  return blocks.map(b=>b.replace(/^\n+|\s+$/g,'')).filter(b=>b.trim()).map(b=>{
    const L=b.split('\n');
    const dm=b.match(/(?:檢查日期|執行日期|檢查時間|Exam(?:ination)?\s*Date)\s*[:：]\s*([^\n]+)/i)||b.match(/(?:報告日期|Report\s*Date)\s*[:：]\s*([^\n]+)/i);
    let dt=toISODate(dm?dm[1]:'')||toISODate(b);
    const tm=b.match(EXAM_TITLE);
    let title=tm?tm[1].split(/\s{3,}/)[0].trim():'';
    if(!title){const l=L.find(l=>l.trim()&&EXAM_TYPES.some(([,re])=>re.test(l))&&l.trim().length<=90);title=(l||L.find(l=>l.trim())||'').trim();}
    let imp='';const ii=L.findIndex(l=>EXAM_IMP.test(l));
    if(ii>=0){const out=[L[ii].replace(EXAM_IMP,'')];for(let j=ii+1;j<L.length;j++){if(EXAM_END.test(L[j]))break;out.push(L[j]);}
      imp=out.join('\n').replace(/^\n+|\s+$/g,'').trim();}
    return {date:dt.slice(0,10),time:dt.slice(11,16),type:examType(title+' '+b.slice(0,300)),title:title.slice(0,120),imp,text:b};
  });
}
function examStore(p){if(!Array.isArray(p.exams))p.exams=[];return p.exams;}
function mergeExams(p,list){
  const E=examStore(p);let add=0,upd=0;
  const sig=x=>x.text.replace(/\s+/g,'').slice(0,200);
  list.forEach(x=>{const ex=E.find(y=>sig(y)===sig(x)||(y.date===x.date&&y.title&&y.title===x.title&&y.time===x.time));
    if(ex){Object.assign(ex,{text:x.text,imp:x.imp||ex.imp,type:ex.typeManual?ex.type:x.type});upd++;}
    else{E.push(Object.assign({id:'e'+uid().slice(1),addedAt:new Date().toISOString()},x));add++;}});
  return {add,upd};
}
