// 3Y2M、2M15D、5歲3月 → 3 歲 2 個月 / 2 個月 15 天
function normAgeText(t){
  t=String(t||'').trim();
  const y=(t.match(/(\d+)\s*(?:歲|Y(?:r|rs|ears?)?)/i)||[])[1],m=(t.match(/(\d+)\s*(?:個?月|M(?:o|on|onths?)?)(?![a-z])/i)||[])[1],d=(t.match(/(\d+)\s*(?:天|日|D(?:ays?)?)(?![a-z])/i)||[])[1];
  if(y==null&&m==null&&d==null)return t;
  return [y!=null?y+' 歲':'',m!=null?m+' 個月':'',d!=null?d+' 天':''].filter(Boolean).join(' ');
}
function ageYears(p){
  if(p.dob&&dobDays(p)!=null)return dobDays(p)/365.25;
  if(p.age!==''&&p.age!=null&&!isNaN(parseFloat(p.age)))return parseFloat(p.age);
  const t=normAgeText(p.ageText||'');const y=(t.match(/(\d+(?:\.\d+)?)\s*歲/)||[])[1],m=(t.match(/(\d+)\s*個?月/)||[])[1],d=(t.match(/(\d+)\s*天/)||[])[1];
  if(y==null&&m==null&&d==null)return null;
  return (+y||0)+(+m||0)/12+(+d||0)/365;
}
function renalCalc(p){
  const cr=latestLab(p,'72-333');if(!cr)return null;
  const scr=labNum(cr);if(!(scr>0))return null;
  const out={scr,crSk:cr.sk};
  const age=ageYears(p),wt=parseFloat(p.wt),ht=parseFloat(p.ht);
  if(p.template==='peds'||(age!=null&&age<18)){
    if(ht>0&&age!=null){
      const gaW=parseFloat(String(p.ga||'').split('+')[0]);
      let k=0.55;
      if(age<1)k=(gaW&&gaW<37)?0.33:0.45;
      else if(age>=13&&p.sex==='M')k=0.7;
      out.peds={k,egfr:k*ht/scr};
    }
    return out;
  }
  if(age!=null&&wt>0&&p.sex){
    const f=p.sex==='F'?0.85:1;
    out.crcl=(140-age)*wt/(72*scr)*f;
    if(ht>0){const ibw=(p.sex==='M'?50:45.5)+0.91*(ht-152.4);
      if(wt>ibw*1.2){out.adj=(140-age)*(ibw+0.4*(wt-ibw))/(72*scr)*f;}
      if(wt<ibw)out.lowWt=true;}
  }
  return out;
}


