function parseConsult(text){
  const r={dept:'',doctor:'',reqDate:'',replyDate:'',reason:'',reply:'',text:String(text||'').replace(/\r/g,'').trim()};
  let cur=null;
  r.text.split('\n').forEach(l=>{
