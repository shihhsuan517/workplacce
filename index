function parseLab(raw){
  const lines=raw.replace(/\r\n?/g,"\n").split("\n");
  const ds=lines.findIndex(l=>l.startsWith("True\t"));
  if(ds<0)throw new Error("找不到資料行（應以 True 開頭）。請確認貼上的是完整的檢驗報告。");
  let tok=[];lines.slice(0,ds).forEach(l=>{tok=tok.concat(l.split("\t"));});
  if(tok.length<6)throw new Error("表頭不完整，請連同「選取／項目代號／項目／檢體別」那幾行一起貼上。");
  const rest=tok.slice(4),dt=rest.slice(0,rest.length-2);
  if(dt.length%2)throw new Error(`表頭日期／時間數量為奇數（${dt.length}），格式可能跑位，請從 HIS 重新複製整份報告。`);
  const dtCols=[];for(let i=0;i<dt.length;i+=2)dtCols.push(labCol(dt[i].trim(),dt[i+1].trim()));
  const n=dtCols.length,rows=[],skipped=[];
  lines.slice(ds).filter(l=>l.trim()).forEach(l=>{
    const pa=l.split("\t");
    if(pa.length<4+n){skipped.push(l.slice(0,60));return;}
    rows.push({code:pa[1],name:pa[2],sampleType:pa[3],unit:pa[4+n]||"",ref:pa[5+n]||"",cells:pa.slice(4,4+n).map(splitVF)});
  });
  const warnings=[];
  for(let i=1;i<n;i++)if(dtCols[i].sortKey>dtCols[i-1].sortKey)warnings.push(`第 ${i}–${i+1} 欄時間沒有遞減（${dtCols[i-1].iso} → ${dtCols[i].iso}），表頭可能跑位`);
