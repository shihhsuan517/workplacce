}
$('fsNotice').innerHTML=FS
  ?'<div class="notice info">修改會自動存回工作檔。建議工作檔放在隨身碟或個人資料夾，換電腦時開同一個檔案即可。</div>'
  :`<div class="notice warn">${IS_TABLET?'平板模式：':'這個瀏覽器不支援直接存檔。'}開啟工作檔後照常使用，<b>結束前按「下載工作檔（存回）」</b>，會產生帶時間的新檔（例如 病患工作檔_1109-1230.jcpw）；回到筆電時開啟時間最新的那個檔。</div>`;


let pendingFileText=null;
$('btnOpen').onclick=async()=>{
  if(FS){
    try{const [h]=await window.showOpenFilePicker({types:FTYPES,multiple:false});
      S.handle=h;S.fileName=h.name;S.mode='fs';pendingFileText=null;showLock('lkUnlock');}
    catch(e){/* 取消 */}
  } else {$('fileInput').dataset.purpose='work';$('fileInput').click();}
};
const APP_VER='2026-11-09c';
function readFileText(f){
  if(f.text)return f.text();
  return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=()=>rej(r.error||new Error('讀取失敗'));r.readAsText(f);});
}
function envProblem(){
  if(!window.isSecureContext)return '目前網址不是 https（或是從「檔案」App 直接預覽），瀏覽器不提供加密功能，無法開啟或建立工作檔。請改用 GitHub Pages 的 https 網址開啟平台。';
  if(!window.crypto||!crypto.subtle)return '這個瀏覽器不支援加密功能（WebCrypto），請更新 iPadOS／瀏覽器版本。';
  return '';
}
(function(){const pr=envProblem();$('envCheck').innerHTML=(pr?`<div class="notice bad">${esc(pr)}</div>`:'')+`平台版本 ${APP_VER}${IS_TABLET?'・平板模式':''}${window.isSecureContext?'・https ✓':'・非 https ✗'}${window.crypto&&crypto.subtle?'・加密 ✓':'・加密 ✗'}`;})();
$('fileInput').onchange=async e=>{
  const f=e.target.files[0];e.target.value='';if(!f)return;
  let txt='';
  try{txt=await readFileText(f);}catch(err){toast('無法讀取檔案：'+(err&&err.message||err));return;}
  if(e.target.dataset.purpose!=='archive'&&e.target.dataset.purpose!=='merge'&&!/"magic"\s*:\s*"JCPW"/.test(txt.slice(0,200))){
    pendingFileText=null;S.fileName=f.name;showLock('lkUnlock');
    $('unlockMsg').innerHTML=`<div class="notice bad">「${esc(f.name)}」不是病患工作檔（${f.size} bytes）。請選擇 .jcpw 檔；若檔名變成 .json 或 .txt 也可以，只要內容是工作檔。</div>`;return;}
  if(e.target.dataset.purpose==='archive'){openArchiveText(txt,f.name);return;}
  if(e.target.dataset.purpose==='merge'){mergeWorkText(txt,f.name);return;}
  pendingFileText=txt;S.handle=null;S.fileName=f.name;S.mode='download';showLock('lkUnlock');
};
$('btnBack1').onclick=()=>{S.handle=null;pendingFileText=null;showLock('lkHome');};
$('btnBack2').onclick=()=>showLock('lkHome');
$('pwUnlock').addEventListener('keydown',e=>{if(e.key==='Enter')$('btnUnlock').click();});


$('btnUnlock').onclick=async()=>{
  const pw=$('pwUnlock').value;if(!pw)return;
  const btn=$('btnUnlock');btn.disabled=true;btn.textContent='解鎖中…';
  try{
    let canWrite=false;
    if(S.mode==='fs'&&S.handle){
      try{canWrite=(await S.handle.requestPermission({mode:'readwrite'}))==='granted';}catch(e){canWrite=false;}
    }
    const pr=envProblem();if(pr)throw new Error(pr);
    const text=S.mode==='fs'?await readFileText(await S.handle.getFile()):pendingFileText;
    if(!text)throw new Error('尚未選擇檔案，請按「改開其他檔案」重新選取');
    const r=await decryptText(text,pw);
    if(r.kind==='archive'){$('unlockMsg').innerHTML='<div class="notice warn">這是舊病患檔，不是工作檔。請進入工作檔後用「開啟舊病患檔」查看。</div>';return;}
    S.data=r.obj;S.km=r.km;S.pw=pw;S.canWrite=S.mode==='fs'?canWrite:false;
    S.dirty=false;S.saveErr=false;S.lastSaved=null;S.archive=null;
    if(!S.data.settings)S.data.settings={hideNames:false};
    if(S.mode==='fs'&&!canWrite)toast('未取得寫入權限：本次為唯讀，修改不會存檔');
    enterApp();
    const mt=metaTxt(S.data);if(mt)setTimeout(()=>toast('此工作檔最後更新：'+mt),2700);
  }catch(e){
    $('unlockMsg').innerHTML=`<div class="notice bad">${e.message==='PASSWORD'?'密碼錯誤。':e.message==='FORMAT'?'這不是有效的工作檔。':'無法讀取檔案：'+esc(e.message)}</div>`;
  }finally{btn.disabled=false;btn.textContent='解鎖';}
};


$('btnNew').onclick=()=>{$('pwNew1').value='';$('pwNew2').value='';$('pwStrength').innerHTML='';showLock('lkCreate');setTimeout(()=>$('pwNew1').focus(),40);};
$('pwNew1').addEventListener('input',()=>$('pwStrength').innerHTML=pwWarn($('pwNew1').value));
$('btnCreate').onclick=async()=>{
  const p1=$('pwNew1').value,p2=$('pwNew2').value;
  if(!p1){$('createMsg').innerHTML='<div class="notice bad">請輸入密碼。</div>';return;}
  if(p1!==p2){$('createMsg').innerHTML='<div class="notice bad">兩次密碼不一致。</div>';return;}
  {const pr=envProblem();if(pr){$('createMsg').innerHTML=`<div class="notice bad">${esc(pr)}</div>`;return;}}
  let handle=null;
  if(FS){
    try{handle=await window.showSaveFilePicker({suggestedName:'病患工作檔.jcpw',types:FTYPES});}
    catch(e){return;}
  }
  const btn=$('btnCreate');btn.disabled=true;btn.textContent='建立中…';
  try{
    S.data=emptyData();S.km=await newKeyMaterial(p1);S.pw=p1;
    S.handle=handle;S.fileName=handle?handle.name:'病患工作檔.jcpw';
    S.mode=handle?'fs':'download';S.canWrite=!!handle;S.archive=null;S.selId=null;
    enterApp();
    if(handle){S.dirty=true;await saveNow();}
    else{S.dirty=true;renderStatus();toast('請按「下載工作檔」把新檔存到你的資料夾');}
  }finally{btn.disabled=false;btn.textContent='選擇存檔位置並建立';}
};


$('btnSample').onclick=()=>{
  S.data=sampleData();S.km=null;S.pw=null;S.handle=null;S.fileName='範例資料';S.mode='sample';S.canWrite=false;S.archive=null;
