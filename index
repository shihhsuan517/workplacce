}


/* ===================== Modal / Toast ===================== */
function modal(title,bodyHtml,buttons){
  return new Promise(res=>{
    $('mT').textContent=title;$('mB').innerHTML=bodyHtml;
    $('mA').innerHTML='';
    buttons.forEach(b=>{const el=document.createElement('button');el.textContent=b.t;if(b.cls)el.className=b.cls;
      el.onclick=()=>{const inputs=[...$('mB').querySelectorAll('input')].map(i=>i.value);$('modal').classList.add('hidden');res({v:b.v,inputs});};
      $('mA').appendChild(el);});
    $('modal').classList.remove('hidden');
    const f=$('mB').querySelector('input');if(f)setTimeout(()=>f.focus(),40);
  });
}
const confirmBox=(t,msg,okText='確定',danger=false)=>modal(t,`<div>${msg}</div>`,[{t:'取消',v:false},{t:okText,v:true,cls:danger?'danger':'pri'}]).then(r=>r.v);
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.remove('hidden');clearTimeout(t._h);t._h=setTimeout(()=>t.classList.add('hidden'),2600);}


/* ===================== 密碼強度 ===================== */
function pwWarn(pw){
  if(!pw)return '';
  if(pw.length<8||/^\d+$/.test(pw))return `<div class="notice warn">這組密碼${/^\d+$/.test(pw)?'只有數字':'少於 8 個字元'}，工作檔若遺失，別人可以在很短時間內用電腦逐一嘗試破解。建議至少 8 個字元並混合英文與數字。仍可使用。</div>`;
  return '<div class="notice info">密碼強度可接受。</div>';
}


/* ===================== 鎖定畫面流程 ===================== */
function showLock(view){
