/* ----- 現行用藥起始時間 ----- */
function startRows(p){
  const order=['drip','abx','reg','prn','once'];
  return (p.medList||[]).filter(m=>!m.expired&&m.cls!=='fluid').map(m=>{
    let start='',approx=false,seg='',days=null;
    if(m.fromOrders){start=m.startAt;approx=m.startMaybeEarlier;seg=m.segAt&&m.segAt!==m.startAt?m.segAt:'';days=m.dot;}
    else{const L=p.medLog[m.key];if(L){start=(L.start||L.first||'').slice(5).replace('-','/');approx=!L.start;days=abxDay(L,true);}}
    return {m,start,approx,seg,days,exp:m.expAt||''};
  }).sort((a,b)=>(order.indexOf(a.m.cls)-order.indexOf(b.m.cls))||((a.m.startTs||0)-(b.m.startTs||0)));
}
