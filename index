  const L=labStore(p);let n=0;const bid='b'+Date.now().toString(36);
  P.dtCols.forEach(c=>{L.cols[c.sortKey]=c;});
  P.rows.forEach(r=>{
    const k=r.code+'|'+r.sampleType+'|'+r.name;
    const it=L.items[k]||(L.items[k]={code:r.code,name:r.name,sampleType:r.sampleType,unit:r.unit,ref:r.ref,vals:{}});
    if(r.unit)it.unit=r.unit;if(r.ref)it.ref=r.ref;
    r.cells.forEach((c,i)=>{if(c){it.vals[P.dtCols[i].sortKey]=Object.assign({},c,{b:bid});n++;}});
  });
  L.pastedAt=new Date().toISOString();
  L.batches=(L.batches||[]).concat({id:bid,at:L.pastedAt,n,items:P.rows.length,from:P.dtCols.length?P.dtCols[P.dtCols.length-1].iso:'',to:P.dtCols.length?P.dtCols[0].iso:''});
