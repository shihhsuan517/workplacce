// 入院紀錄／病程中的新生兒資料：GA、出生體重、出生日、身長、性別
function neoExtract(t,refYear){
  const o={};t=String(t||'');
  let m=t.match(/\bGA\s*[:：]?\s*(\d{2})\s*(?:\+\s*(\d))?\s*(?:weeks?|wks?|週)/i)||t.match(/gestational\s+age\s+(?:of\s+)?(\d{2})\s*(?:\+\s*(\d))?\s*weeks?/i);
  if(m)o.ga=m[1]+(m[2]?'+'+m[2]:'');
  m=t.match(/\bBBW\s*[:：]?\s*(\d{3,4})\s*(?:g|gm|grams?)\b/i)||t.match(/birth\s+(?:body\s+)?weight\s+(?:of\s+)?(\d{3,4})\s*(?:g|gm|grams?)\b/i)||t.match(/Weight\s*[:：]\s*(\d{3,4})\s*gm?\b/i);
  if(m)o.birthWt=m[1];
  m=t.match(/\bGender\s*[:：]\s*(male|female)/i);if(m)o.sex=/^f/i.test(m[1])?'F':'M';
  else if(/\b(?:this\s+)?female\s+(?:patient|neonate|infant|baby)/i.test(t))o.sex='F';else if(/\b(?:this\s+)?male\s+(?:patient|neonate|infant|baby)/i.test(t))o.sex='M';
  m=t.match(/\bBBL\s*[:：]\s*(\d{2})(?:\.\d)?\s*cm/i)||t.match(/\bLength\s*[:：]\s*(\d{2}(?:\.\d)?)\s*cm/i);if(m)o.ht=m[1];
  const bt=t.match(/(?:delivered|born)[^.\n]{0,120}?\bat\s*(\d{1,2}):(\d{2})\s*(?:on\s*\d{1,2}\/\d{1,2})?/i);if(bt)o.birthTime=`${pad(+bt[1])}:${bt[2]}`;
  m=t.match(/(?:delivered|born)[^.\n]{0,120}?\bon\s*(\d{1,2})\/(\d{1,2})\b/i)||t.match(/\[\s*(\d{1,2})\/(\d{1,2})\s*,\s*GA\b/i);
  if(m&&refYear){let y=+refYear;const mo=+m[1];if(mo>new Date().getMonth()+1&&mo>10&&new Date().getMonth()<2)y--;o.dob=`${y}-${pad(mo)}-${pad(+m[2])}`;}
  return o;
}
function applyNeo(p,o){
  const got=[];
  if(o.ga&&!p.ga){p.ga=o.ga;got.push('GA '+o.ga+' 週');}
  if(o.birthWt&&!p.birthWt){p.birthWt=o.birthWt;got.push('出生體重 '+o.birthWt+' g');}
  if(o.sex&&!p.sex){p.sex=o.sex;got.push(o.sex==='F'?'女':'男');}
  if(o.dob&&!p.dob){p.dob=o.dob;got.push('出生日 '+o.dob);}
  if(o.birthTime&&!p.birthTime){p.birthTime=o.birthTime;got.push('出生時間 '+o.birthTime);}
  if(o.ht&&!p.ht){p.ht=o.ht;got.push('身長 '+o.ht+' cm');}
  if(o.birthWt&&!p.wt){p.wt=String(+o.birthWt/1000);p.wtAt=p.wtAt||'';got.push('體重暫以出生體重');}
  if((o.ga||o.dob)&&p.template==='adult'){p.template='peds';got.push('切換兒科範本');}
  return got;
}


/* =====================================================================
   病程紀錄（Progress note：S／O／A／P）
   ===================================================================== */
const PN_SEC=/^\s*([SOAPＳＯＡＰ])\s*[:：]\s*(.*)$/;
const FW={'Ｓ':'S','Ｏ':'O','Ａ':'A','Ｐ':'P'};
function isProgress(t){
  const seen=[];String(t||'').split(/\r?\n/).forEach(l=>{const m=l.match(PN_SEC);if(m)seen.push(FW[m[1]]||m[1]);});
  return seen.includes('S')&&seen.includes('A')&&seen.includes('P');
}
function parseProgress(text){
  const L=String(text||'').replace(/\r/g,'').split('\n');
