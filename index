const D_CAT=/^\s{0,4}(NEWD|NEW|CHG|REN|EXTN|TAPE|PREP|EXP|DC-[A-Z]|DC|\*\*\*#|St|ST)\s/;
// 劑量與頻次在欄寬不足時會黏在一起（如 0.75PCQ12H），所以單位用已知清單比對，頻次前的空白可省略
