  if(p.template==='peds'){const pr=paliEval(p);if(pr&&(pr.eligible||pr.flags.length>1||pr.inOrder))h+=renderPali(p,true,true);
    if(pr&&pr.eligible&&!pr.given)rem.push(`符合 Palivizumab 健保給付（8.2.8，最多 ${pr.max} 劑），尚未記錄施打`);
    else if(pr&&pr.eligible&&pr.next&&pr.given<pr.max&&pr.next<=ymd())rem.push(`Palivizumab 第 ${pr.given+1} 劑已到預計日（${pr.next}）`);}
  if(hasTPN(p)){const R=tpnOf(p),r=R.rows[R.rows.length-1],c=r.calc;
    h+=`<div class="card" style="margin:0"><h3>TPN <span class="small mute">${esc(tFmt(r.t))}</span></h3>
      ${kv('TDF',r.tdf?r.tdf.mlkg+' mL/kg/day':'—')}${kv('AA',r.pn?`${r.pn.aa??'—'} g/kg/day`:'—')}${kv('脂肪',r.lipid?`${r.lipid.g??'—'} g/kg/day`:'—')}
      ${c.kcal?kv('熱量',`${c.kcal.toFixed(0)} kcal/kg/day${c.dexKnown?'':' <span class="small mute">（未含葡萄糖）</span>'}`):''}${c.gir!=null?kv('GIR',c.gir.toFixed(1)+' mg/kg/min'):''}
      ${c.flags.filter(f=>f[0]!=='info').map(([k,t])=>`<div class="small ${k==='bad'?'over':'under'}">⚠ ${esc(t)}</div>`).join('')}
      <div style="margin-top:8px"><button class="small" onclick="S.tab='tpn';renderMain()">查看 TPN</button></div></div>`;}
  // 輸注
  const ids=Object.keys(p.drips||{}).filter(id=>DRIP_BY_ID[id]);
  h+=`<div class="card" style="margin:0"><h3>輸注</h3>${ids.length?ids.map(id=>{
    const c=DRIP_BY_ID[id],d=p.drips[id],r=computeResult(c,+d.amp,+d.dose,+d.vol,+d.flow,parseFloat(p.wt));
    let v='<span class="mute">未填流速</span>';
    if(r.stage==='done'){const bad=r.rangesEval.some(x=>x.flag==='over'),low=r.rangesEval.some(x=>x.flag==='under');
      v=`<span class="${bad?'over':low?'under':'ok'}">${bad?'⚠ ':''}${esc(doseSummary(c,r))}</span>`;}
    if(r.concWarn)v+=' <span class="over">濃度過高</span>';
    return kv(`${c.label}${d.flow?` <span class="small mute">${esc(d.flow)} mL/hr</span>`:''}`,v);
  }).join(''):'<div class="small mute">無</div>'}</div>`;
  // 抗生素
  const R=ordersOf(p);
  if(R){
    const act=R.groups.filter(g=>g.abx&&g.open),stopped=R.groups.filter(g=>g.abx&&!g.open);
    h+=`<div class="card" style="margin:0"><h3>抗微生物製劑 <span class="small mute">LOT ${R.lot} 天</span></h3>${act.length?act.map(g=>kv(esc(g.label),`<b>DOT ${g.course.dot}</b> <span class="small mute">自 ${g.course.start?MT.fmtDay(g.course.start):'?'}</span>`)).join(''):'<div class="small mute">目前無</div>'}
      ${stopped.length?`<div class="small mute" style="margin-top:6px">已停：${stopped.map(g=>`${esc(g.label)} ${g.course.start?MT.fmtDay(g.course.start):'?'}–${g.course.end?MT.fmtDay(g.course.end):'?'}`).join('、')}</div>`:''}</div>`;
  }else{
    const inList=new Set((p.medList||[]).filter(m=>!m.expired).map(m=>m.key));
    const abx=Object.entries(p.medLog||{}).filter(([k,L])=>L.abx&&inList.has(k));
    h+=`<div class="card" style="margin:0"><h3>抗生素</h3>${abx.length?abx.map(([k,L])=>kv(esc(L.name),`<b>D${abxDay(L,true)}</b> <span class="small mute">自 ${esc(L.start||L.first)}</span>`)).join(''):'<div class="small mute">無</div>'}</div>`;
  }
  // 呼吸器
  const V=RT.summary(p,rtCtx(p));
  if(V){
    const vs=[V.mode,V.ps!=null?'PS '+V.ps:null,V.pinsp!=null?'PC '+V.pinsp:null,V.peep!=null?'PEEP '+V.peep:null,V.fio2!=null?'FiO₂ '+V.fio2+'%':null].filter(Boolean).join('・');
    h+=`<div class="card" style="margin:0"><h3>呼吸器 <span class="small mute">${esc(V.time||'')}</span></h3>
      ${kv('設定',esc(vs||'—'))}
      ${V.vt!=null?kv('Vte / RR',`${esc(V.vt)} mL${V.vtkg!=null?` <span class="${V.vtkg>8?'over':'small mute'}">(${V.vtkg.toFixed(1)} mL/kg PBW)</span>`:''} / ${V.rr??'—'}`):''}
      ${V.dp!=null?kv('Driving P'+(V.dpEst?'（估）':''),`<span class="${V.dp>15?'over':''}">${V.dp.toFixed(0)}</span>`):''}
      ${V.pf!=null?kv('P/F',`<span class="${V.pf<=200?'over':V.pf<=300?'under':''}">${V.pf.toFixed(0)}</span> <span class="small mute">${esc((V.pfTime||'').slice(5))}</span>`):''}
      ${V.rsbi!=null&&V.spont?kv('RSBI',`<span class="${V.rsbi>=105?'over':''}">${V.rsbi.toFixed(0)}</span>`):''}
      ${V.mvday!=null?kv('MV 天數',esc(V.mvday)):''}
      <div style="margin-top:8px"><button class="small" onclick="S.tab='rt';renderMain()">查看呼吸治療判讀</button></div></div>`;
  }
  // 培養
  if(hasMicro(p)){
    const C=coverage(p),L=microList(p).slice(0,5);
    h+=`<div class="card" style="margin:0"><h3>培養</h3>${L.map(R=>kv(`${esc((R.collected||'').slice(5,10))} ${esc(R.spec)}`,
      R.orgs.length?R.orgs.map(o=>{const cv=C.rows.find(x=>x.o===o);return `${esc(o.name)}${orgFlags(o,R).map(([t,c])=>` <span class="tag ${c==='bad'?'t-abx':'t-warn'}">${t}</span>`).join('')}${cv&&C.act.length&&!cv.flags.some(f=>f[0]==='可能污染菌')?(cv.covered?' <span class="tag t-new">已涵蓋</span>':cv.sdd?' <span class="tag t-warn">僅 SDD</span>':' <span class="tag t-abx">未涵蓋</span>'):''}`;}).join('<br>'):(R.noGrowth?'無菌生長':R.noOrgYet?'尚無菌株報告':'—'))).join('')}
      <div style="margin-top:8px"><button class="small" onclick="S.tab='micro';renderMain()">查看抗微生物圖譜</button></div></div>`;
  }
  // 檢查／會診
  const EX=examSorted(p).slice(0,3),CO=consSorted(p).filter(c=>c.status!=='結案');
  if(EX.length||CO.length){
    h+=`<div class="card" style="margin:0"><h3>檢查・會診</h3>
      ${EX.map(x=>kv(`${esc((x.date||'').slice(5).replace('-','/'))} ${esc(x.type)}`,`<span class="small">${esc(oneLine(x.title,40))}${x.imp?`<br><span class="mute">${esc(oneLine(x.imp,90))}</span>`:''}</span>`)).join('')}
      ${CO.map(c=>kv(`${esc((c.reqDate||'').slice(5).replace('-','/'))} ${esc(c.dept||'會診')}`,`<span class="tag ${c.status==='待回覆'?'t-warn':'t-new'}">${esc(c.status)}</span>${c.reply?`<span class="small mute"> ${esc(oneLine(c.reply,60))}</span>`:''}`)).join('')}
      <div style="margin-top:8px" class="row">${EX.length?`<button class="small" onclick="S.tab='exam';renderMain()">查看檢查報告</button>`:''}${CO.length?`<button class="small" onclick="S.tab='consult';renderMain()">查看會診</button>`:''}</div></div>`;
  }
  // 關鍵檢驗
  if(hasLabs(p)){
    const KEY=[['Na','72-355'],['K','72-356'],['BUN','72-307'],['Cr','72-333'],['eGFR','72-335'],['AST','72-360'],['ALT','72-361'],['T-Bil','72-365'],['Albumin','72-303'],['WBC','72A001'],['Hb','72C001'],['PLT','72I001'],['INR','72C037'],['CRP','72-112'],['PCT','72-570'],['Lactate','72-419'],['pH','72C530']];
    const rows=KEY.map(([lab,code])=>{const v=latestLab(p,code),pv=latestLab(p,code,'B',1);if(!v)return '';
      const c=v.flag==='H'?'lh':v.flag==='L'?'ll':'';
      const val=String(v.value).replace(/\s*\(.*?\)\s*/g,'');
      const prev=pv?` <span class="small mute">← ${esc(String(pv.value).replace(/\s*\(.*?\)\s*/g,''))}</span>`:'';
      return kv(`${lab} <span class="small mute">${skMD(v.sk)}</span>`,`<span class="${c}">${esc(val)}${v.flag?' '+v.flag:''}</span>${prev}`);}).join('');
    const r=renalCalc(p);
    const ren=r?(r.peds?kv('eGFR (Brion)',`${r.peds.egfr.toFixed(1)}`):r.crcl!=null?kv('CrCl (C-G)',`<b>${r.crcl.toFixed(1)}</b> mL/min${r.adj!=null?` <span class="small mute">AdjBW ${r.adj.toFixed(1)}</span>`:''}`):''):'';
    h+=`<div class="card" style="margin:0"><h3>檢驗 <span class="small mute">最新 ← 前次</span></h3>${rows}${ren}
      <div style="margin-top:8px"><button class="small" onclick="S.tab='lab';renderMain()">查看全部檢驗</button></div></div>`;
  }
  // 用藥摘要
  const list=(p.medList||[]).filter(m=>!m.expired);
  const cnt=k=>list.filter(m=>m.cls===k).length;
  h+=`<div class="card" style="margin:0"><h3>用藥</h3>${list.length?kv('輸注',cnt('drip'))+kv('抗生素',cnt('abx'))+kv('常規',cnt('reg'))+kv('PRN',cnt('prn'))+kv('單次',cnt('once')):'<div class="small mute">尚未貼上醫囑</div>'}
    <div style="margin-top:8px"><button class="small" onclick="S.tab='meds';renderMain()">查看用藥</button></div></div>`;
  h+='</div>';
  if(rem.length)h+=`<div class="notice warn" style="margin-top:12px">${rem.map(esc).join('<br>')}</div>`;
  h+=`<div class="small mute" style="margin-top:12px">${hasLabs(p)?'':'貼上檢驗報告後，關鍵檢驗會顯示於此。'}${V?'':'貼上呼吸治療紀錄後，呼吸器摘要會顯示於此。'}</div>`;
  return h;
}


