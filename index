  if(S.mode==='sample'||(!S.handle&&S.mode!=='download')){showLock('lkHome');}
  else if(S.mode==='download'){showLock('lkHome');}
  else showLock('lkUnlock');
  if(reason)$('unlockMsg').innerHTML=`<div class="notice info">${reason}</div>`;
}
$('btnLock').onclick=()=>lockNow();
let idleTimer=null;
function resetIdle(){clearTimeout(idleTimer);if(S.data)idleTimer=setTimeout(()=>lockNow(`閒置超過 ${IDLE_MIN} 分鐘已自動鎖定。`),IDLE_MIN*60000);}
['mousemove','keydown','click','touchstart','scroll'].forEach(ev=>document.addEventListener(ev,resetIdle,{passive:true}));


