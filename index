<script>
'use strict';


/*CRYPTO-START*/
const ITER = 600000;
const TE = new TextEncoder(), TD = new TextDecoder();
function b64(u8){let s='';for(let i=0;i<u8.length;i+=0x8000)s+=String.fromCharCode.apply(null,u8.subarray(i,i+0x8000));return btoa(s);}
function unb64(s){const b=atob(s),u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u;}
async function deriveKey(pw,salt,iter){
  const base=await crypto.subtle.importKey('raw',TE.encode(pw),'PBKDF2',false,['deriveKey']);
  return crypto.subtle.deriveKey({name:'PBKDF2',salt,iterations:iter,hash:'SHA-256'},base,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);
}
async function newKeyMaterial(pw){const salt=crypto.getRandomValues(new Uint8Array(16));return {salt,iter:ITER,key:await deriveKey(pw,salt,ITER)};}
async function encryptObj(obj,km,kind){
  const iv=crypto.getRandomValues(new Uint8Array(12));
  const ct=new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv},km.key,TE.encode(JSON.stringify(obj))));
  return JSON.stringify({magic:'JCPW',v:1,kind,kdf:'PBKDF2-SHA256',iter:km.iter,salt:b64(km.salt),iv:b64(iv),data:b64(ct)});
}
async function decryptText(text,pw){
  let env;try{env=JSON.parse(text);}catch(e){throw new Error('FORMAT');}
  if(!env||env.magic!=='JCPW')throw new Error('FORMAT');
  const salt=unb64(env.salt),iter=env.iter||ITER,key=await deriveKey(pw,salt,iter);
  let pt;try{pt=await crypto.subtle.decrypt({name:'AES-GCM',iv:unb64(env.iv)},key,unb64(env.data));}catch(e){throw new Error('PASSWORD');}
  return {obj:JSON.parse(TD.decode(pt)),km:{key,salt,iter},kind:env.kind||'work'};
}
/*CRYPTO-END*/


/* ===================== 狀態 ===================== */
const FS = 'showOpenFilePicker' in window && 'showSaveFilePicker' in window;
const IS_TABLET=/iPad|Android|Tablet/i.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
