    allergy:'no known food or drugs allergic history',dx:'',admitDate:ymd(),template:'adult',
    ga:'',birthWt:'',notes:'',createdAt:now,updatedAt:now,
    // 後續階段使用
    medList:[],medLog:{},medPasteAt:'',drips:{},dripHistory:[],orderSources:[],
