  if(p.template==='peds'&&p.dob){
    const bt=new Date(`${p.dob}T${p.birthTime||'00:00'}:00`),ct=new Date(`${c.slice(0,4)}-${c.slice(4,6)}-${c.slice(6,8)}T${c.slice(8,10)}:${c.slice(10,12)}:00`);
